  { keys: "Ctrl+Alt+E", action: "Connect Claude Code" },
  { keys: "Ctrl+Alt+Z", action: "Sign in with OpenAI Codex" },
  { keys: "Ctrl+Alt+Shift+G", action: "Sign in with Google Antigravity" },
  { keys: "Ctrl+Alt+Shift+L", action: "Log out of OAuth account" },
  { keys: "Ctrl+Alt+X", action: "Cancel the active response" },
  { keys: "Ctrl+Alt+Shift+X / Esc", action: "Stop the agent immediately" },
  { keys: "Enter", action: "Send prompt (when chat input is focused)" },
  { keys: "↑ / ↓", action: "Cycle through your previous prompts in the chat input" },
];

