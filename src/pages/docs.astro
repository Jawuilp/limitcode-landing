const settingsExample = `{
  "default_provider": "openrouter",
  "default_model": "anthropic/claude-sonnet-5",
  "api_keys": {
    "openrouter": "sk-or-...",
    "anthropic": "sk-ant-...",
    "openai": "sk-..."
  },
  "temperature": 0.7,
  "max_tokens": "auto",
  "max_iterations": 50,
  "reasoning_effort": "medium",
  "chat_font_size": "auto",
  "show_thoughts": true,
  "show_cost_estimate": true,
  "web_search": {
    "provider": "auto",
    "brave_api_key": "",
    "tavily_api_key": "",
    "max_results": 5
  },
  "permission": {
    "outside_project": "ask",
    "allowed_external_paths": [],
    "tool": {
      "read_file": "allow",
      "list_files": "allow",
      "search_files": "allow",
      "write_to_file": "ask",
      "edit_file": "ask",
      "apply_diff": "ask",
      "execute_command": "ask",
      "web_search": "ask",
      "web_fetch": "ask",
      "mcp": "ask"
    },
    "file": {
      "allow": ["src/**", "lib/**", "app/**", "*.py", "*.js", "*.ts", "*.md"],
      "deny": ["**/*.lock", ".env", "**/.env*", "**/*.pem", "**/*.key", "**/node_modules/**"]
    }
  }
}`;

const settingsKeys = [
  { key: "default_provider / default_model", desc: "The active AI provider and model used when opening a chat. Updated automatically when you switch models via Ctrl+Alt+M." },
  { key: "api_keys", desc: "Dictionary of API keys per provider (e.g. openrouter, anthropic, openai, gemini, deepseek, mistral, groq)." },
  { key: "provider_base_urls", desc: "Custom base URLs per provider (used for self-hosted gateways, proxies, or custom OpenAI-compatible endpoints)." },
  { key: "reasoning_effort", desc: "Controls how deeply reasoning-capable models think before answering: \"off\", \"low\", \"medium\", or \"high\"." },
  { key: "temperature", desc: "Sampling temperature for generation (e.g. 0.7), or \"auto\" to use the model's recommended default." },
  { key: "max_tokens", desc: "Maximum output tokens per response (integer) or \"auto\" to use the model's native limit." },
  { key: "max_iterations", desc: "Maximum number of autonomous steps the agent can take in a single turn before pausing." },
  { key: "permission", desc: "Rules controlling which tools and file patterns run automatically (\"allow\"), prompt for confirmation (\"ask\"), or are blocked (\"deny\")." },
  { key: "web_search", desc: "Configure web search: provider (\"auto\", \"brave\", \"tavily\", \"duckduckgo\", \"sogou\"), brave_api_key, tavily_api_key, and max_results. Works out of the box via DuckDuckGo/Sogou, or upgrades to Brave/Tavily when a key is added." },
  { key: "instruction_files", desc: "List of project instruction filenames to load automatically (AGENTS.md, CLAUDE.md, .limitcode.md, INSTRUCTIONS.md)." },
  { key: "auto_discover_instructions", desc: "When true, automatically finds and loads instruction files in your project hierarchy." },
  { key: "skills / mcp", desc: "Configuration for Agent Skills and connected MCP servers." },
  { key: "chat_font_size / chat_style", desc: "Set a dedicated font size for the chat view (or \"auto\" to match Sublime) and customize visual accents." },
  { key: "show_thoughts / show_cost_estimate", desc: "Show or hide collapsible model reasoning blocks and live session cost estimates." },
  { key: "skip_dirs / skip_extensions", desc: "Folders (like node_modules, .git, dist) and file extensions excluded from directory listings and searches." },
  { key: "terminal_shell", desc: "Preferred shell for running commands (e.g. \"pwsh\", \"powershell\", \"bash\", \"zsh\", \"git-bash\", \"cmd\")." },
];

