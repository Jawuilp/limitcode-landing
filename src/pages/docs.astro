const modes = [
  {
    name: "Code",
    when: "Everyday feature building, refactoring, and multi-file implementation.",
    canDo: "Read, search, create, edit, and patch files; run shell commands and background jobs; update the live task checklist; load Skills and MCP tools.",
  },
  {
    name: "Ask",
    when: "Exploring an unfamiliar repository, understanding logic, or asking questions with zero risk of modifying files.",
    canDo: "Read-only access: list directories, search across files, read code, and consult Skills or MCP tools. File edits and shell commands are disabled.",
  },
  {
    name: "Architect",
    when: "Designing a feature, writing technical specs, or planning a complex migration before touching production code.",
    canDo: "Explore and search the project, read files, and write documentation or plan files without running shell commands.",
  },
  {
    name: "Debug",
    when: "Tracking down a bug, analyzing stack traces, running reproduction scripts, and applying targeted fixes.",
    canDo: "Search and read files, run diagnostic commands and test suites, apply targeted code edits or diffs, and verify fixes.",
  },
];

const subagents = [
  {
    name: "explore",
    purpose: "Map out directory structure and locate where specific logic lives in the codebase.",
    capabilities: "Read files, list folders, search patterns (read-only)",
  },
  {
    name: "general",
    purpose: "Investigate a broad question across multiple files and return a concise summary to the main chat.",
    capabilities: "Read files, list folders, search patterns (read-only)",
  },
  {
    name: "plan",
    purpose: "Draft a step-by-step implementation plan in Markdown based on your project's actual code.",
    capabilities: "Read files, list folders, search patterns (read-only)",
  },
  {
    name: "implement",
    purpose: "Carry out a self-contained coding subtask (creating or editing specific files).",
    capabilities: "Read, list, search, create, edit, and patch files",
  },
  {
    name: "test",
    purpose: "Execute your test suite or verification commands and report pass/fail results.",
    capabilities: "Read files, list folders, run shell commands",
  },
];

const agentActions = [
  { name: "read_file", category: "Project Discovery", desc: "Read the contents of any file in your workspace (or a specific line range) to understand existing code." },
  { name: "list_files", category: "Project Discovery", desc: "Browse the files and folders inside any directory of your project." },
  { name: "search_files", category: "Project Discovery", desc: "Search for functions, symbols, text, or patterns across your entire repository." },
  { name: "write_to_file", category: "Code Editing", desc: "Create a brand-new file or replace the contents of an existing file." },
  { name: "edit_file", category: "Code Editing", desc: "Make precise, targeted replacements inside an existing file without rewriting the whole file." },
  { name: "apply_diff", category: "Code Editing", desc: "Apply multi-hunk diff patches to a file." },
  { name: "execute_command", category: "Terminal & Builds", desc: "Run shell commands such as test suites, linters, compilers, package managers, or git commands." },
  { name: "background_job", category: "Terminal & Builds", desc: "Monitor the output of, or stop, a long-running command started in the background (like a dev server)." },
  { name: "web_search", category: "Web & Docs", desc: "Search the live web (via Brave, Tavily, DuckDuckGo, or Sogou) to check up-to-date documentation or solutions." },
  { name: "web_fetch", category: "Web & Docs", desc: "Open and read a specific documentation URL or web page." },
  { name: "skill", category: "Extensions", desc: "Load specialized instructions, templates, and reference files from an installed Agent Skill." },
  { name: "skill_manager", category: "Extensions", desc: "List, search, create, or install Agent Skills in your project or global skills folder." },
  { name: "mcp", category: "Extensions", desc: "Discover and call tools exposed by your configured Model Context Protocol (MCP) servers." },
  { name: "task", category: "Orchestration", desc: "Delegate a focused subtask (explore, plan, implement, test, or research) to a child subagent." },
  { name: "batch", category: "Orchestration", desc: "Run multiple independent actions (such as reading several files at once) in parallel to save time." },
  { name: "update_checklist", category: "Orchestration", desc: "Create and update the live step-by-step task checklist displayed inside your chat panel." },
];

const mcpExample = `{
  "mcp": {
    "playwright": {
      "type": "local",
      "command": ["npx", "-y", "@playwright/mcp@latest"],
      "enabled": true
    },
    "stripe": {
      "type": "remote",
      "url": "https://mcp.stripe.com",
      "headers": {
        "Authorization": "Bearer {env:STRIPE_RESTRICTED_KEY}"
      },
      "enabled": true
    }
  }
}`;

const webSearchExample = `{
  "web_search": {
