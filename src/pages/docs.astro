---
import Layout from "../layouts/Layout.astro";
import Nav from "../components/Nav.astro";
import Footer from "../components/Footer.astro";
import VideoCard from "../components/VideoCard.astro";

const quickSteps = [
  {
    ord: "01",
    title: "Download the matching build",
    body: "After checkout, keep the activation key and download the Limitcode Pro package matched to your Sublime Text build (current or next-generation plugin host).",
  },
  {
    ord: "02",
    title: "Install and activate",
    body: "Copy the package into Sublime Text's Installed Packages folder, restart Sublime Text, then activate this device from the Command Palette.",
    code: "Limitcode Pro: Activate License",
  },
  {
    ord: "03",
    title: "Connect a provider",
    body: "Add an API key, sign in with a supported account, reuse an existing CLI login, or point Limitcode at a local endpoint. Then open Limitcode Chat.",
    code: "Limitcode: Setup Provider API Key",
  },
];

const capabilities = [
  {
    name: "What Limitcode is",
    body: "An agentic coding assistant that lives inside Sublime Text: a streaming chat plus an agent loop that can read, write, and edit files, run commands, search the web, and extend itself. Nothing runs in a separate IDE.",
    meta: ["native Sublime panel", "agent loop", "tool calling"],
  },
  {
    name: "Work against the project on disk",
    body: "The agent lists, reads, and searches your actual project files, creates targeted edits, applies diffs, and runs build or test commands — all from the same conversation.",
    meta: ["list", "read", "search", "edit", "patch", "run"],
  },
  {
    name: "Approval boundaries you control",
    body: "Reads and searches can stay frictionless while writes, change previews, shell commands, web access, and MCP calls ask by default. Rules are set per tool and per file.",
    meta: ["allow / ask / deny", "file globs", "per tool"],
  },
  {
    name: "Scoped modes",
    body: "Code, Architect, Ask, and Debug modes give each step a different toolset, instead of one always-maximal configuration.",
    meta: ["Code", "Architect", "Ask", "Debug"],
  },
  {
    name: "Review before it lands",
    body: "See a native diff before an edit is applied, and undo or redo any agent edit during the session. After an edit, syntax and type errors from Sublime's LSP feed back to the agent.",
    meta: ["diffs", "undo / redo", "LSP diagnostics"],
  },
  {
    name: "Context that survives long sessions",
    body: "Conversations are saved by project and long sessions compact automatically near the model's context limit, so you can pick a task back up without losing the thread.",
    meta: ["per-project sessions", "auto-compaction", "typed messages"],
  },
  {
    name: "Web search and page fetching",
    body: "Built-in web search and URL fetching let the agent check docs and current information; both ask for permission by default. Some providers also expose native search.",
    meta: ["web search", "fetch URL", "opt-in"],
  },
  {
    name: "See images",
    body: "Paste a screenshot or image into the chat and image-capable models can reason about it — inspect UI bugs, diagrams, or design mockups.",
    meta: ["paste image", "vision"],
  },
  {
    name: "Extend it: instructions, skills, MCP, subagents",
    body: "Load repository instructions, reusable skills, and any MCP server you configure, and delegate focused work to subagents — all under the same permission rules.",
    meta: ["instructions", "skills", "MCP", "subagents"],
  },
  {
    name: "Bring your own model",
    body: "More than 40 registered providers: direct APIs, account sign-in, existing CLI logins, or local OpenAI-compatible runtimes such as Ollama, LM Studio, and LiteLLM. You pay your provider directly.",
    meta: ["40+ providers", "OAuth", "CLI bridges", "local"],
  },
  {
    name: "Know the cost",
    body: "Provider, model, reasoning effort, context, and per-session cost statistics are always one status bar away, with an optional budget alert.",
    meta: ["provider", "model", "reasoning effort", "session cost"],
  },
];

const tools = [
  { name: "read_file", desc: "Read a file, optionally a line range." },
  { name: "write_to_file", desc: "Create or overwrite a whole file." },
  { name: "edit_file", desc: "Targeted old → new replacement, with fuzzy matching." },
  { name: "apply_diff", desc: "Apply a unified diff patch to a file." },
  { name: "list_files", desc: "List the files in a directory." },
  { name: "search_files", desc: "Search patterns across files (ripgrep, grep, or Python fallback)." },
  { name: "execute_command", desc: "Run a shell command — builds, tests, git. Supports background jobs." },
  { name: "background_job", desc: "Inspect or stop a job started earlier by execute_command." },
  { name: "web_search", desc: "Real web search (Brave, Tavily, DuckDuckGo, Sogou)." },
  { name: "web_fetch", desc: "Fetch and parse a URL (HTML → Markdown, SSRF-guarded)." },
  { name: "skill", desc: "Load a skill's full instructions and resources." },
  { name: "skill_manager", desc: "List, create, install, or search Agent Skills." },
  { name: "mcp", desc: "List tools from an MCP server, or call one." },
  { name: "task", desc: "Launch a subagent for focused work." },
  { name: "batch", desc: "Run several independent tool calls in parallel." },
  { name: "update_checklist", desc: "Publish the task list to the live checklist in the chat." },
];

const modes = [
  { name: "Code", desc: "General coding tasks.", tools: "read, write, edit, diff, list, search, execute, background, skill, mcp, checklist" },
  { name: "Architect", desc: "Planning and technical design.", tools: "read, write, list, search, skill, mcp" },
  { name: "Ask", desc: "Questions and explanations (read-only).", tools: "read, list, search, skill, mcp" },
  { name: "Debug", desc: "Diagnosis and fixes.", tools: "read, write, edit, diff, search, execute, background, skill, mcp" },
];

const subagents = [
  { name: "explore", role: "Explore structure and find information.", tools: "read, list, search", iter: "10" },
  { name: "general", role: "Research and summarize.", tools: "read, list, search", iter: "25" },
  { name: "implement", role: "Scoped code task — create or edit.", tools: "read, list, search, write, edit, diff", iter: "15" },
  { name: "plan", role: "Write a detailed Markdown plan.", tools: "read, list, search", iter: "15" },
  { name: "test", role: "Run tests and report.", tools: "read, execute_command, list", iter: "10" },
];

const providerGroups = [
  {
    name: "OpenAI-compatible endpoints",
    body: "One adapter over any /chat/completions endpoint: OpenAI, Groq, Mistral, xAI (Grok), DeepSeek, Cerebras, DeepInfra, Together AI, Venice AI, Cloudflare Workers AI, GitLab, SAP AI Core, Perplexity, Vercel AI Gateway, Alibaba DashScope, Helicone, NVIDIA NIM, Moonshot/Kimi, Alibaba, and any custom base URL — plus local runtimes Ollama, LM Studio, and LiteLLM.",
  },
  {
    name: "Providers with a native handler",
    body: "Anthropic and Vertex Anthropic, Google Gemini and Vertex (native generateContent), Azure OpenAI, Amazon Bedrock (Converse), Cohere, OpenRouter (a proxy over 500+ models), and GitHub Copilot.",
  },
  {
    name: "Account, CLI, and OAuth routes",
    body: "Sign in with GitHub Copilot, OpenAI Codex, or Google Antigravity (OAuth). The Claude Code and Codex CLI bridges reuse an existing local CLI login. Credentials live in Sublime Text settings.",
  },
];

const paletteGroups = [
  {
    name: "Session",
    commands: ["Open Chat", "New Chat", "Chat History", "Rename Session", "Delete Session", "Clear Chat"],
  },
  {
    name: "Agent & configuration",
    commands: ["Send to Agent", "Change Provider", "Change Model", "Change Mode", "Set Reasoning Effort", "Setup Provider API Key", "Toggle Permissions", "Show Instructions", "Show Cost Statistics", "Open MCP Settings"],
  },
  {
    name: "Account sign-in",
    commands: ["Login with GitHub Copilot (OAuth)", "Login with Claude Code", "Login with Codex (OAuth)", "Login with Google Antigravity (OAuth)", "Logout OAuth"],
  },
  {
    name: "Edit safety",
    commands: ["Undo Last Agent Edit", "Redo Last Agent Edit", "Show Snapshot History"],
  },
  {
    name: "Limitcode Pro",
    commands: ["Activate License", "Show License Status", "Deactivate This Device"],
  },
];

const shortcuts = [
  { keys: "Ctrl+Alt+L", action: "Open chat" },
  { keys: "Ctrl+Alt+A", action: "Send selection or file to the agent" },
  { keys: "Ctrl+Alt+N", action: "New chat" },
  { keys: "Ctrl+Alt+H", action: "Chat history" },
  { keys: "Ctrl+Alt+Y", action: "Rename session" },
  { keys: "Ctrl+Alt+D", action: "Delete session" },
  { keys: "Ctrl+Alt+M", action: "Change model" },
  { keys: "Ctrl+Alt+P", action: "Change provider" },
  { keys: "Ctrl+Alt+Shift+M", action: "Change mode" },
  { keys: "Ctrl+Alt+R", action: "Set reasoning effort" },
  { keys: "Ctrl+Alt+T", action: "Toggle show thoughts" },
  { keys: "Ctrl+Alt+K", action: "Setup provider API key" },
  { keys: "Ctrl+Alt+S", action: "Open settings" },
  { keys: "Ctrl+Alt+Q", action: "Open MCP settings" },
  { keys: "Ctrl+Alt+G", action: "Open skills folder" },
  { keys: "Ctrl+Alt+O", action: "Toggle permissions" },
  { keys: "Ctrl+Alt+Shift+Y", action: "Trust agent (allow all)" },
  { keys: "Ctrl+Alt+Shift+U", action: "Untrust agent (ask all)" },
  { keys: "Ctrl+Alt+F", action: "Show instructions" },
  { keys: "Ctrl+Alt+C", action: "Clear chat" },
  { keys: "Ctrl+Alt+U", action: "Undo last agent edit" },
  { keys: "Ctrl+Alt+Shift+R", action: "Redo last agent edit" },
  { keys: "Ctrl+Alt+Shift+V", action: "Show snapshot history" },
  { keys: "Ctrl+Alt+Shift+C", action: "Show cost statistics" },
  { keys: "Ctrl+Alt+B", action: "Login with GitHub Copilot" },
  { keys: "Ctrl+Alt+E", action: "Login with Claude Code" },
  { keys: "Ctrl+Alt+Z", action: "Login with Codex" },
  { keys: "Ctrl+Alt+Shift+G", action: "Login with Google Antigravity" },
  { keys: "Ctrl+Alt+Shift+L", action: "Logout OAuth" },
  { keys: "Ctrl+Alt+X", action: "Cancel the active request" },
  { keys: "Ctrl+Alt+Shift+X", action: "Stop the agent" },
  { keys: "Enter", action: "Send the message (chat focused)" },
  { keys: "↑ / ↓", action: "Input history in the chat" },
];

const settingsKeys = [
  { key: "default_provider / default_model", desc: "Active provider and model." },
  { key: "api_keys", desc: "Credentials per provider." },
  { key: "provider_base_urls", desc: "Base URLs per provider." },
  { key: "temperature", desc: "Generation temperature." },
  { key: "max_tokens", desc: "Output cap (integer) or \"auto\" for the model's native limit." },
  { key: "max_iterations", desc: "Maximum agent-loop iterations." },
  { key: "reasoning_effort", desc: "off / low / medium / high." },
  { key: "permission", desc: "Allow / deny / ask rules (tool and file)." },
  { key: "web_search", desc: "provider, API keys, max_results." },
  { key: "skip_dirs / skip_extensions", desc: "Exclusions for listing and search." },
  { key: "instruction_files", desc: "Instruction files to discover." },
  { key: "auto_discover_instructions", desc: "Auto-discover AGENTS.md and similar." },
  { key: "skills / mcp", desc: "Skills and MCP servers." },
  { key: "chat_style / chat_font_size", desc: "Chat styling and font size." },
  { key: "show_thoughts / show_cost_estimate", desc: "Reasoning display and cost estimate." },
  { key: "terminal_shell", desc: "Shell used by execute_command." },
  { key: "streaming / timeout", desc: "Streaming and network timeout." },
  { key: "debug_log / debug_console_log", desc: "Sanitized JSON log and console mirror." },
];

const settingsExample = `{
  "default_provider": "openrouter",
  "default_model": "anthropic/claude-sonnet-4-20250514",
  "api_keys": {
    "openrouter": "sk-..."
  },
  "temperature": 0.7,
  "max_tokens": 4096,
  "max_iterations": 25,
  "permission": {
    "outside_project": "ask",
    "tool": {
      "read_file": "allow",
      "list_files": "allow",
      "search_files": "allow",
      "write_to_file": "ask",
      "edit_file": "ask",
      "apply_diff": "ask",
      "execute_command": "ask",
      "web_search": "ask",
      "web_fetch": "ask",
      "mcp": "ask"
    },
    "file": {
      "allow": ["src/**", "lib/**", "app/**", "*.py", "*.js", "*.ts", "*.md"],
      "deny": ["**/*.lock", ".env", "**/*.pem", "**/*.key", "**/node_modules/**", "**/.git/**"]
    }
  }
}`;

const faq = [
  {
    q: "Does Limitcode need a separate daemon or service?",
    a: "No. Limitcode runs inside Sublime Text. API-key providers work directly from the plugin; account, CLI, and local integrations use their own optional setup.",
  },
  {
    q: "Where are my credentials stored?",
    a: "API keys and OAuth tokens are stored in Sublime Text settings, not an operating-system keychain. Review the provider's terms before connecting a work or primary personal account.",
  },
  {
    q: "Which Sublime Text builds are supported?",
    a: "Separate downloads are provided for the current and the next-generation Sublime Text plugin hosts, so you install the package matched to your build.",
  },
  {
    q: "What happens when I log out of an account provider?",
    a: "Logout removes the stored credentials from local settings. It does not revoke the token on the provider side — revoke access in the provider's own security settings if you want it invalidated server-side.",
  },
  {
    q: "Can Limitcode see images?",
    a: "Yes. Paste a screenshot or image into the chat (Ctrl+V / Cmd+V on Windows, macOS, and Linux) and image-capable models can see and reason about it, for example to inspect UI bugs, diagrams, or design mockups.",
  },
  {
    q: "Can Limitcode search the web?",
    a: "Yes. Web search and URL fetching are built-in tools that ask for permission by default. The search backend is configurable, and some providers also expose their own native web search.",
  },
  {
    q: "Can I use skills and MCP servers?",
    a: "Yes. Skills load specialized instructions on demand, and any MCP server you configure becomes callable as a tool — both under the same permission rules as the rest of the agent.",
  },
  {
    q: "Can I change how much the agent is allowed to do?",
    a: "Yes. Modes (Code, Architect, Ask, Debug) scope the toolset, and permissions scope tools and files. You can raise or lower both per task.",
  },
  {
    q: "Can I use local models?",
    a: "Yes. Ollama, LM Studio, LiteLLM, and custom OpenAI-compatible endpoints are supported. Tool calling depends on the endpoint and model implementation.",
  },
  {
    q: "Can account-based integrations change or stop working?",
    a: "Yes. Codex, Copilot, and Antigravity routes depend on provider-controlled accounts and service behavior. Availability, quotas, and compatibility can change independently of Limitcode. See the Providers page for account-risk notes.",
  },
];
---

<Layout
  title="Docs — Limitcode Pro"
  description="What Limitcode can do, plus installation, tools, modes, subagents, permissions, settings, commands, shortcuts, and FAQ for Limitcode Pro."
  canonicalPath="/docs/"
>
  <!-- FAQPage schema: lets AI engines extract the Q&A directly -->
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": faq.map((item) => ({
      "@type": "Question",
      "name": item.q,
      "acceptedAnswer": { "@type": "Answer", "text": item.a },
    })),
  })} />
  <Nav />
  <main>
    <section class="docs-hero">
      <div class="container">
        <span class="eyebrow reveal"><span class="dot"></span>Documentation</span>
        <h1 class="reveal d1">Everything Limitcode can do.</h1>
        <p class="lead reveal d2">
          The full surface of Limitcode Pro in Sublime Text: capabilities, the agent's tools,
          modes, subagents, skills and MCP, permissions, sessions and cost, review and safety,
          providers, the Command Palette, shortcuts, and settings.
        </p>
      </div>
    </section>

    <section class="docs-section container">
      <div class="section-head">
        <span class="section-num">01 — Quick start</span>
        <h2>From download to first task.</h2>
      </div>
      <div class="quick-grid">
        {quickSteps.map((s) => (
          <article class="quick-card">
            <span class="ord">{s.ord}</span>
            <h3>{s.title}</h3>
            <p>{s.body}</p>
            {s.code && <div class="code"><span class="c">$</span> {s.code}</div>}
          </article>
        ))}
      </div>
    </section>

    <section class="docs-section container">
      <div class="section-head">
        <span class="section-num">02 — Capabilities</span>
        <h2>What Limitcode can do.</h2>
        <p>Limitcode is a coding agent that lives inside Sublime Text. Here is the full surface — what it does, and the boundaries it works under.</p>
      </div>
      <div class="cap-list">
        {capabilities.map((cap, i) => (
          <article class="cap-row">
            <span class="cap-num">{String(i + 1).padStart(2, "0")}</span>
            <div class="cap-body">
              <h3>{cap.name}</h3>
              <p>{cap.body}</p>
              <div class="cap-meta">
                {cap.meta.map((m) => <code>{m}</code>)}
              </div>
            </div>
          </article>
        ))}
      </div>
    </section>

    <section class="docs-section container">
      <div class="section-head">
        <span class="section-num">03 — The agent's tools</span>
        <h2>Sixteen tools it can call.</h2>
        <p>
          The agent works through a fixed catalogue of tools. Each mode exposes a subset, and
          every call runs under your permission rules. Independent calls can run together with{" "}
          <code class="inline-code">batch</code>, and long-running commands can be tracked with{" "}
          <code class="inline-code">background_job</code>.
        </p>
      </div>
      <div class="table-wrap">
        <table class="docs-table">
          <thead>
            <tr><th>Tool</th><th>What it does</th></tr>
          </thead>
          <tbody>
            {tools.map((t) => (
              <tr><td><code>{t.name}</code></td><td>{t.desc}</td></tr>
            ))}
          </tbody>
        </table>
      </div>
    </section>

    <section class="docs-section container">
      <div class="section-head">
        <span class="section-num">04 — Modes</span>
        <h2>Scope the toolset per task.</h2>
        <p>
          A mode decides which tools the agent may use. Switch with{" "}
          <code class="inline-code">Limitcode: Change Mode</code> (<code class="inline-code">Ctrl+Alt+Shift+M</code>).
        </p>
      </div>
      <div class="table-wrap">
        <table class="docs-table">
          <thead>
            <tr><th>Mode</th><th>Best for</th><th>Tools</th></tr>
          </thead>
          <tbody>
            {modes.map((m) => (
              <tr><td><code>{m.name}</code></td><td>{m.desc}</td><td>{m.tools}</td></tr>
            ))}
          </tbody>
        </table>
      </div>
    </section>

    <section class="docs-section container">
      <div class="section-head">
        <span class="section-num">05 — Subagents</span>
        <h2>Delegate focused work.</h2>
        <p>
          A subagent is a child session with its own agent and a restricted toolset. Subagents
          cannot spawn other subagents, and their permissions derive from the parent.
        </p>
      </div>
      <div class="table-wrap">
        <table class="docs-table">
          <thead>
            <tr><th>Type</th><th>Role</th><th>Tools</th><th>Max iterations</th></tr>
          </thead>
          <tbody>
            {subagents.map((s) => (
              <tr><td><code>{s.name}</code></td><td>{s.role}</td><td>{s.tools}</td><td>{s.iter}</td></tr>
            ))}
          </tbody>
        </table>
      </div>
    </section>

    <section class="docs-section container">
      <div class="section-head">
        <span class="section-num">06 — Instructions, skills, and MCP</span>
        <h2>Teach it your project.</h2>
      </div>
      <div class="sub-groups">
        <div class="sub-group">
          <h3>Repository instructions</h3>
          <p>
            Limitcode walks up the directory tree and auto-discovers instruction files:{" "}
            <code class="inline-code">AGENTS.md</code>, <code class="inline-code">CLAUDE.md</code>,{" "}
            <code class="inline-code">.limitcode.md</code>, <code class="inline-code">.kilocode.md</code>, and{" "}
            <code class="inline-code">INSTRUCTIONS.md</code>. Run{" "}
            <code class="inline-code">Limitcode: Show Instructions</code> to see what was found.
          </p>
        </div>
        <div class="sub-group">
          <h3>Agent Skills</h3>
          <p>
            A skill is a bundle of instructions with optional resources — a{" "}
            <code class="inline-code">SKILL.md</code> plus <code class="inline-code">scripts/</code>,{" "}
            <code class="inline-code">templates/</code>, and <code class="inline-code">references/</code>.
            Skills are discovered bundled with the plugin, in the project (
            <code class="inline-code">.agents/skills/&lt;name&gt;/SKILL.md</code>), or globally (
            <code class="inline-code">~/.agents/skills/</code>). The <code class="inline-code">skill</code>{" "}
            tool loads one when a task matches; <code class="inline-code">skill_manager</code> lists,
            creates, installs, and searches them.
          </p>
        </div>
        <div class="sub-group">
          <h3>MCP servers</h3>
          <p>
            Connect Model Context Protocol servers so their tools become callable. Both local
            (stdio, started as a process) and remote (Streamable HTTP with an API key) are
            supported, with <code class="inline-code">{"{env:VAR}"}</code> expansion for secrets. Open the
            config with <code class="inline-code">Limitcode: Open MCP Settings</code> (
            <code class="inline-code">Ctrl+Alt+Q</code>).
          </p>
        </div>
      </div>
    </section>

    <section class="docs-section container">
      <div class="section-head">
        <span class="section-num">07 — Permissions</span>
        <h2>You approve what mutates.</h2>
        <p>
          Permissions use <code class="inline-code">allow</code>, <code class="inline-code">ask</code>, and{" "}
          <code class="inline-code">deny</code> actions on <code class="inline-code">{"{permission, pattern, action}"}</code>{" "}
          rules with last-match-wins semantics. They apply per tool and per file, and match flexibly
          (absolute paths, basenames, relative suffixes like <code class="inline-code">src/**</code> or{" "}
          <code class="inline-code">*.py</code>).
        </p>
      </div>
      <div class="perm-grid">
        <div>
          <h3>By default</h3>
          <p>
            Reads, listings, and searches are allowed; writes, change previews, shell commands,
            web access, skills, and MCP calls ask first. <code class="inline-code">outside_project</code>{" "}
            controls access beyond the workspace, and <code class="inline-code">allowed_external_paths</code>{" "}
            authorizes specific external paths.
          </p>
        </div>
        <div>
          <h3>At runtime</h3>
          <p>
            An <code class="inline-code">always allow</code> choice is scoped to the session and not
            persisted. Use <code class="inline-code">Limitcode: Toggle Permissions</code>, or the
            trust commands to allow or ask for everything. If you deny an action, the agent is told
            not to retry it through another tool.
          </p>
        </div>
      </div>
    </section>

    <section class="docs-section container">
      <div class="section-head">
        <span class="section-num">08 — Sessions, memory, and cost</span>
        <h2>Picks up where you left off.</h2>
      </div>
      <div class="sub-groups">
        <div class="sub-group">
          <h3>History and memory</h3>
          <p>
            Each chat is saved as Markdown under the project, and the agent keeps typed message
            memory for the session — text, reasoning, tool calls, files and images, iteration
            steps, and errors. The Command Palette offers{" "}
            <code class="inline-code">New Chat</code>, <code class="inline-code">Chat History</code>,{" "}
            <code class="inline-code">Rename Session</code>, and <code class="inline-code">Delete Session</code>.
          </p>
        </div>
        <div class="sub-group">
          <h3>Auto-compaction</h3>
          <p>
            As the conversation approaches the model's context limit, a dedicated compaction agent
            summarizes it while preserving critical technical detail, and the summary is re-injected
            as the main context. You keep working without a manual reset.
          </p>
        </div>
        <div class="sub-group">
          <h3>Cost</h3>
          <p>
            Limitcode tracks session cost, input/output tokens, and last context usage, using
            per-model pricing. See it with <code class="inline-code">Limitcode: Show Cost Statistics</code>{" "}
            (<code class="inline-code">Ctrl+Alt+Shift+C</code>); an optional budget alert warns when you pass a set limit.
          </p>
        </div>
      </div>
    </section>

    <section class="docs-section container">
      <div class="section-head">
        <span class="section-num">09 — Review and safety</span>
        <h2>Nothing changes behind your back.</h2>
      </div>
      <div class="sub-groups">
        <div class="sub-group">
          <h3>Native diffs</h3>
          <p>
            The agent proposes changes as a diff you review before applying, opened in Sublime's own
            diff view with Accept, Reject, Next, and Prev.
          </p>
        </div>
        <div class="sub-group">
          <h3>Snapshots and undo</h3>
          <p>
            Before editing, Limitcode snapshots the file. That powers{" "}
            <code class="inline-code">Undo Last Agent Edit</code> and{" "}
            <code class="inline-code">Redo Last Agent Edit</code>, a file watcher for external changes, and
            protection against stale edits. <code class="inline-code">Show Snapshot History</code> lists them.
          </p>
        </div>
        <div class="sub-group">
          <h3>LSP feedback</h3>
          <p>
            After an edit, Limitcode waits briefly for fresh LSP diagnostics and reports any errors
            back to the model, so it can self-correct. It degrades gracefully when no LSP is present.
          </p>
        </div>
      </div>
