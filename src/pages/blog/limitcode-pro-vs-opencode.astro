---
import Layout from "../../layouts/Layout.astro";
import Nav from "../../components/Nav.astro";
import Footer from "../../components/Footer.astro";

const tldr = [
  {
    label: "What it is",
    pro: "A coding agent that works inside Sublime Text",
    tm: "A free, open-source AI coding agent for the terminal",
  },
  {
    label: "Interface",
    pro: "Native side-by-side Sublime Text view",
    tm: "Terminal TUI",
  },
  {
    label: "Sublime Text integration",
    pro: "Native, first-class",
    tm: "None official — hosts like TermMate can dock the CLI",
  },
  {
    label: "Provider model",
    pro: "BYOK: OpenAI, Anthropic, Gemini, DeepSeek, OpenRouter, Copilot, local models",
    tm: "BYOK: many providers, including local models",
  },
  {
    label: "License",
    pro: "One-time purchase, up to 3 devices",
    tm: "Open source, free",
  },
  {
    label: "Editor-native tools",
    pro: "Send to Agent, selection context, snapshot undo/redo, LSP diagnostics",
    tm: "Terminal-driven workflow",
  },
  {
    label: "Setup",
    pro: "Install the package, connect a provider",
    tm: "Install the CLI, run it in a terminal",
  },
];

const features = [
  { f: "Native Sublime Text support", pro: true, tm: false },
  { f: "Works in the terminal", pro: false, tm: true },
  { f: "Bring your own keys (BYOK)", pro: true, tm: true },
  { f: "Local models (Ollama, LM Studio)", pro: true, tm: true },
  { f: "MCP servers", pro: true, tm: true },
  { f: "Agent reads, edits, and runs approved commands", pro: true, tm: true },
  { f: "Send selection or active file with one shortcut", pro: true, tm: false },
  { f: "Snapshot undo/redo of agent edits", pro: true, tm: false },
  { f: "LSP diagnostics fed back to the agent", pro: true, tm: false },
  { f: "Permission rules with editor prompts", pro: true, tm: "in-TUI prompts" },
  { f: "Session history per project", pro: true, tm: true },
  { f: "One-time license (open source core also available)", pro: true, tm: true },
];

const faqs = [
  {
    q: "Is OpenCode free?",
    a: "Yes — OpenCode is open source, so the agent itself costs nothing. Like Limitcode, it is bring-your-own-key: you pay your model provider directly for what you use. Limitcode Pro adds a one-time license for the packaged, editor-native experience; the open-source Limitcode edition remains free for pair programming.",
  },
  {
    q: "Does OpenCode work with Sublime Text?",
    a: "Not natively. OpenCode is a terminal TUI, and there is no official Sublime Text plugin. Hosts such as TermMate can dock the OpenCode CLI inside an editor panel — but the agent doing the work is still the CLI, with its own runtime and approvals. Limitcode Pro is a native Sublime package, not a hosted CLI.",
  },
  {
    q: "Both are BYOK — so what is actually different?",
    a: "Where the agent lives and how much it integrates with the editor. OpenCode gives you a strong terminal UI and gets out of the way of how you configure it. Limitcode Pro gives you the agent inside Sublime Text: send the selection or active file with one shortcut, get editor prompts for permissions, snapshot undo/redo for agent edits, and LSP diagnostics fed back into the loop.",
  },
  {
    q: "Can I use the same providers in both?",
    a: "Largely yes. Both connect to the major API providers and to local OpenAI-compatible endpoints such as Ollama and LM Studio. Availability of specific models depends on each tool's provider adapters — check the Providers page for Limitcode's current list.",
  },
  {
    q: "Which should I pick?",
    a: "If you enjoy living in the terminal and want a free, open-source TUI agent, OpenCode is a solid choice. If you want the agent to live inside Sublime Text — next to your files, with editor-native tools and a one-time license — Limitcode Pro is built for that.",
  },
];

const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Article",
      headline: "Limitcode Pro vs OpenCode: AI Coding Inside Sublime vs Terminal-First Agents",
      description:
        "Both are BYOK coding agents, but OpenCode lives in the terminal and Limitcode Pro lives inside Sublime Text. Integration, permissions, recovery, and pricing compared.",
      datePublished: "2026-08-27",
      dateModified: "2026-08-27",
      author: { "@id": "https://jawuil.dev/#organization" },
      publisher: { "@id": "https://limitcode.jawuil.dev/#organization" },
      mainEntityOfPage: "https://limitcode.jawuil.dev/blog/limitcode-pro-vs-opencode/",
    },
    {
      "@type": "BreadcrumbList",
      itemListElement: [
        { "@type": "ListItem", position: 1, name: "Home", item: "https://limitcode.jawuil.dev/" },
        { "@type": "ListItem", position: 2, name: "Blog", item: "https://limitcode.jawuil.dev/blog/" },
        { "@type": "ListItem", position: 3, name: "Limitcode Pro vs OpenCode" },
      ],
    },
    {
      "@type": "FAQPage",
      mainEntity: faqs.map((f) => ({
        "@type": "Question",
        name: f.q,
        acceptedAnswer: { "@type": "Answer", text: f.a },
      })),
    },
  ],
};
---

<Layout
  title="Limitcode Pro vs OpenCode: Sublime Text vs Terminal-First Agents"
  description="Both are BYOK coding agents, but OpenCode lives in the terminal and Limitcode Pro lives inside Sublime Text. Integration, permissions, recovery, and pricing compared."
  canonicalPath="/blog/limitcode-pro-vs-opencode/"
>
  <script type="application/ld+json" set:html={JSON.stringify(schema)} slot="head-extra" />
  <Nav />
  <main>
    <section class="post-hero">
      <div class="container">
        <span class="eyebrow reveal"><span class="dot"></span>Comparison · Aug 2026</span>
        <h1 class="reveal d1">Limitcode Pro vs OpenCode</h1>
        <p class="lead reveal d2">
          These two agree on more than most: both are bring-your-own-key agents
          that refuse to lock you to one provider. The disagreement is about
          where the agent should live.
        </p>
      </div>
    </section>

    <section class="container">
      <div class="verdict reveal d3">
        <span class="verdict-label">Short answer</span>
        <p>
          <strong>OpenCode</strong> is a free, open-source coding agent that
          runs in the terminal with the provider you bring — a strong pick if
          the TUI is home. <strong>Limitcode Pro</strong> shares the BYOK
          philosophy but runs natively inside Sublime Text, with editor-native
          tools (Send to Agent, permission prompts, snapshot undo/redo, LSP
          diagnostics) and a one-time license. Terminal-first? OpenCode may be
          the better fit. Want the agent inside Sublime?{" "}
          <a href="/#pricing">Limitcode Pro</a> is designed for that.
        </p>
      </div>
    </section>

    <section class="post-section container" id="tldr">
      <div class="section-head">
        <span class="section-num">01 — At a glance</span>
        <h2>The short version.</h2>
      </div>
      <div class="table-wrap">
        <table class="cmp">
          <thead>
            <tr>
              <th scope="col"><span class="sr-only">Aspect</span></th>
              <th scope="col" class="col-pro">Limitcode Pro</th>
              <th scope="col">OpenCode</th>
            </tr>
          </thead>
          <tbody>
            {tldr.map((row) => (
              <tr>
                <th scope="row">{row.label}</th>
                <td class="col-pro">{row.pro}</td>
                <td>{row.tm}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </section>

    <section class="post-section container" id="what-is-opencode">
      <div class="section-head">
        <span class="section-num">02 — The contender</span>
        <h2>What is OpenCode?</h2>
        <p>
          <a href="https://opencode.ai" target="_blank" rel="noopener">OpenCode</a>
          is an open-source AI coding agent built for the terminal. It presents
          a TUI, connects to many model providers with your own keys (including
          local models), supports LSP integration, MCP servers, and
          extensibility, and follows a client/server architecture that lets the
          agent run as a local server with clients attaching to it.
        </p>
        <p>
          It is free software with an active community, and it is honest about
          what it is: a terminal-first agent. Editor integration is not the
          goal — although third-party hosts such as TermMate can dock the
          OpenCode CLI inside an editor panel.
        </p>
      </div>
    </section>

    <section class="post-section container" id="what-is-limitcode">
      <div class="section-head">
        <span class="section-num">03 — The challenger</span>
        <h2>What is Limitcode Pro?</h2>
        <p>
          Limitcode Pro is a lightweight coding agent that lives inside Sublime
          Text (builds 4050+) — no separate AI IDE, and no separate agent daemon
          required for direct API providers. In a side-by-side chat view it
          inspects project files, proposes targeted edits for approval, runs
          approved shell commands, searches the web, loads skills, calls MCP
          servers, and runs focused subagents under configurable permission
          rules.
        </p>
        <p>
          Like OpenCode, it is provider-agnostic: OpenAI, Anthropic, Gemini,
          DeepSeek, OpenRouter, Copilot, Codex, Antigravity, or local endpoints
          such as Ollama and LM Studio — switchable per task, with your keys and
          your accounts. Details on the <a href="/providers/">Providers page</a>.
        </p>
      </div>
    </section>

    <section class="dark-section">
      <div class="container">
        <div class="section-head light">
          <span class="section-num">04 — The core difference</span>
          <h2>Same philosophy, different home.</h2>
          <p>
            Both agents believe you should own the model layer: bring your keys,
            switch providers, keep local options open. OpenCode expresses that
            philosophy in the terminal; Limitcode Pro expresses it inside the
            editor. That single difference changes the daily loop.
          </p>
          <p>
            In the terminal, context flows through what you type and paste. In
            Sublime, the agent sits next to your files: the selection you have
            highlighted, the file you have open, the LSP diagnostics your editor
            already computed. Limitcode leans into that — Send to Agent passes
            explicit context with one shortcut, and snapshot undo/redo gives
            every agent edit a recovery path without leaving the editor.
          </p>
        </div>
      </div>
    </section>

    <section class="post-section container" id="features-compared">
      <div class="section-head">
        <span class="section-num">05 — Feature by feature</span>
        <h2>Side by side.</h2>
      </div>
      <div class="table-wrap">
        <table class="cmp cmp-tight">
          <thead>
            <tr>
              <th scope="col"><span class="sr-only">Feature</span></th>
              <th scope="col" class="col-pro">Limitcode Pro</th>
              <th scope="col">OpenCode</th>
            </tr>
          </thead>
          <tbody>
            {features.map((row) => (
              <tr>
                <th scope="row">{row.f}</th>
                <td class="col-pro">{row.pro === true ? "✓" : row.pro}</td>
                <td>{row.tm === true ? "✓" : row.tm === false ? "—" : row.tm}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </section>

    <section class="post-section container" id="pricing-compared">
      <div class="section-head">
        <span class="section-num">06 — Pricing</span>
        <h2>Free and open source vs one-time license.</h2>
        <p>
          OpenCode is free, open-source software — you pay your model provider
          directly for usage. Limitcode Pro is a <a href="/#pricing">one-time
          license valid on up to three devices</a>, with the same rule for model
          usage: paid directly to the provider you choose, at cost. The
          open-source Limitcode edition remains free for pair programming, so
          you can evaluate the workflow before committing to anything.
        </p>
      </div>
    </section>

    <section class="post-section container" id="which-one">
      <div class="section-head">
        <span class="section-num">07 — The honest verdict</span>
        <h2>Which one should you pick?</h2>
      </div>
      <div class="pick-grid">
        <article class="pick-card">
          <h3>OpenCode makes sense if…</h3>
          <ul>
            <li>The terminal is where you already live and work.</li>
            <li>You want a free, open-source agent with no license to buy.</li>
            <li>You like configuring and extending your own tooling.</li>
            <li>You want a client/server setup you can shape yourself.</li>
          </ul>
        </article>
        <article class="pick-card pick-card-pro">
          <span class="pick-flag">Our pick for Sublime Text</span>
          <h3>Limitcode Pro makes sense if…</h3>
          <ul>
            <li>You write code in Sublime Text and want the agent to live there.</li>
            <li>You value editor-native integration: selection context, permission prompts, undo/redo.</li>
            <li>You want a packaged experience with support, not a DIY setup.</li>
            <li>You prefer owning a one-time license over assembling free parts.</li>
          </ul>
        </article>
      </div>
    </section>

    <section class="post-section container" id="faq">
      <div class="section-head">
        <span class="section-num">08 — FAQ</span>
        <h2>Questions people actually ask.</h2>
      </div>
      <div class="faq-list">
        {faqs.map((f) => (
          <details class="faq-item">
            <summary>{f.q}</summary>
            <p>{f.a}</p>
          </details>
        ))}
      </div>
    </section>

    <section class="container post-related-wrap">
      <aside class="related">
        <span class="related-label">Keep reading</span>
        <a href="/blog/limitcode-pro-vs-claude-code">Limitcode Pro vs Claude Code →</a>
        <a href="/blog/limitcode-pro-vs-pi">Limitcode Pro vs Pi →</a>
        <a href="/blog">All posts →</a>
      </aside>
    </section>

    <section class="container post-cta-wrap">
      <div class="about-cta">
        <div>
          <h3>The lightweight agent for Sublime Text.</h3>
          <p>Limitcode Pro: a full coding agent inside the Sublime Text window you already have open.</p>
        </div>
        <div class="about-cta-links">
          <a class="btn btn-primary" href="/#pricing">Get Limitcode Pro <span class="arrow">→</span></a>
          <a class="btn btn-quiet" href="/docs">Read the docs →</a>
        </div>
      </div>
    </section>
  </main>
  <Footer />
</Layout>

<style>
  .post-hero {
    padding-top: clamp(64px, 8vw, 112px);
    padding-bottom: clamp(48px, 6vw, 80px);
  }

  .post-hero h1 {
    max-width: 16ch;
    margin: 18px 0 22px;
  }

  .lead {
    max-width: 58ch;
  }

  .verdict {
    border: 1px solid var(--hairline);
    border-left: 3px solid var(--signal);
    background: var(--paper-deep);
    padding: 28px 32px;
    max-width: 860px;
  }

  .verdict-label {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--signal);
  }

  .verdict p {
    margin-top: 12px;
    max-width: 68ch;
  }

  .post-section {
    padding-top: clamp(56px, 7vw, 96px);
    padding-bottom: clamp(24px, 3vw, 40px);
    border-top: 1px solid var(--hairline);
    margin-top: clamp(24px, 3vw, 40px);
  }

  .post-section .section-head p {
    max-width: 66ch;
  }

  .post-section .section-head p + p {
    margin-top: 12px;
  }

  .dark-section {
    margin-top: clamp(24px, 3vw, 40px);
    padding-top: clamp(56px, 7vw, 96px);
    padding-bottom: clamp(56px, 7vw, 96px);
    background: var(--editor);
    border-top: 1px solid var(--hairline);
  }

  .dark-section h2 {
    color: var(--paper);
  }

  .dark-section .section-num {
    color: rgba(243, 239, 229, 0.6);
  }

  .dark-section p {
    color: rgba(243, 239, 229, 0.78);
    max-width: 66ch;
    margin-top: 12px;
  }

  .table-wrap {
    overflow-x: auto;
    margin-top: clamp(28px, 4vw, 44px);
    border: 1px solid var(--hairline);
  }

  table.cmp {
    width: 100%;
    border-collapse: collapse;
    min-width: 560px;
  }

  table.cmp th,
  table.cmp td {
    text-align: left;
    padding: 14px 18px;
    border-bottom: 1px solid var(--hairline);
    vertical-align: top;
    font-size: 0.92rem;
  }

  table.cmp tbody tr:last-child th,
  table.cmp tbody tr:last-child td {
    border-bottom: none;
  }

  table.cmp thead th {
    font-family: var(--font-mono);
    font-size: 0.74rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--muted);
    background: var(--paper-deep);
  }

  table.cmp tbody th[scope="row"] {
    font-weight: 600;
    white-space: nowrap;
    color: var(--ink);
  }

  td.col-pro {
    border-left: 1px solid var(--hairline);
  }

  thead th.col-pro {
    color: var(--signal);
    box-shadow: inset 0 3px 0 var(--signal);
  }

  .cmp-tight th,
  .cmp-tight td {
    padding: 10px 18px;
  }

  .pick-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 18px;
    margin-top: clamp(32px, 5vw, 52px);
  }

  .pick-card {
    padding: 28px;
    border: 1px solid var(--hairline);
    background: var(--paper-deep);
  }

  .pick-card h3 {
    font-size: var(--step-1);
    margin-bottom: 16px;
  }

  .pick-card ul {
    padding-left: 18px;
    display: grid;
    gap: 10px;
  }

  .pick-card li {
    font-size: 0.92rem;
    color: var(--ink-soft);
  }

  .pick-card-pro {
    border-color: var(--signal);
    position: relative;
  }

  .pick-flag {
    position: absolute;
    top: -11px;
    left: 24px;
    background: var(--signal);
    color: #fff;
    font-family: var(--font-mono);
    font-size: 0.66rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    padding: 3px 10px;
  }

  .faq-list {
    margin-top: clamp(28px, 4vw, 44px);
    max-width: 820px;
  }

  .faq-item {
    border-bottom: 1px solid var(--hairline);
  }

  .faq-item summary {
    cursor: pointer;
    font-weight: 600;
    padding: 18px 0;
    list-style-position: outside;
  }

  .faq-item p {
    padding-bottom: 20px;
    max-width: 64ch;
    color: var(--ink-soft);
  }

  .post-related-wrap {
    margin-top: clamp(40px, 5vw, 72px);
  }

  .related {
    display: flex;
    align-items: center;
    gap: 24px;
    flex-wrap: wrap;
    padding: 20px 24px;
    border: 1px solid var(--hairline);
    background: var(--paper-deep);
  }

  .related-label {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--muted);
  }

  .related a {
    font-weight: 600;
  }

  .post-cta-wrap {
    margin-top: clamp(24px, 3vw, 40px);
    padding-bottom: clamp(64px, 8vw, 112px);
  }

  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  @media (max-width: 800px) {
    .pick-grid {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 640px) {
    .post-hero {
      padding-top: clamp(48px, 12vw, 72px);
    }

    .post-hero h1 {
      font-size: var(--step-3);
    }

    .verdict {
      padding: 22px 20px;
    }

    .post-section .section-head h2 {
      font-size: var(--step-3);
    }
  }
</style>
