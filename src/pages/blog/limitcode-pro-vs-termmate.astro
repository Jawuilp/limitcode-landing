---
import Layout from "../../layouts/Layout.astro";
import Nav from "../../components/Nav.astro";
import Footer from "../../components/Footer.astro";

const tldr = [
  {
    label: "What it is",
    pro: "A native coding agent inside Sublime Text",
    tm: "A host that runs external agent CLIs",
  },
  {
    label: "Editors",
    pro: "Sublime Text 4",
    tm: "Sublime Text + VS Code",
  },
  {
    label: "Setup",
    pro: "One package, nothing else to install",
    tm: "One install per hosted CLI (Claude Code, Codex, OpenCode, Pi)",
  },
  {
    label: "Models",
    pro: "Direct provider keys or account sign-in — local models included",
    tm: "Whatever each hosted agent supports",
  },
  {
    label: "Permissions",
    pro: "One configurable rule set covers every action",
    tm: "Approval settings differ per agent",
  },
  {
    label: "Undo",
    pro: "Snapshot undo/redo",
    tm: "Depends on the connected agent",
  },
  {
    label: "Price",
    pro: "One-time license, up to 3 devices",
    tm: "Free; hosted agents billed separately",
  },
];

const features = [
  { f: "Runs inside Sublime Text", pro: true, tm: true },
  { f: "Self-contained agent (no extra CLIs)", pro: true, tm: false },
  { f: "Project-wide search and edits", pro: true, tm: "via agent" },
  { f: "Approved shell commands", pro: true, tm: "via agent" },
  { f: "Bring your own API key", pro: true, tm: false },
  { f: "Account sign-in (Copilot, Codex, Antigravity)", pro: true, tm: false },
  { f: "Local models (Ollama, LM Studio)", pro: true, tm: "partial" },
  { f: "MCP servers", pro: true, tm: "partial" },
  { f: "Web search", pro: true, tm: "via agent" },
  { f: "Skills and subagents", pro: true, tm: false },
  { f: "Automatic context compaction", pro: true, tm: "via agent" },
  { f: "Snapshot undo/redo", pro: true, tm: false },
  { f: "Consistent permission rules", pro: true, tm: false },
  { f: "Session persistence", pro: true, tm: true },
  { f: "VS Code support", pro: false, tm: true },
  { f: "Free to install", pro: false, tm: true },
];

const faqs = [
  {
    q: "Is TermMate free?",
    a: "Yes, TermMate itself is free to install on both Sublime Text (Package Control) and VS Code (Marketplace). The real cost sits behind it: the agent CLIs it hosts, such as Claude Code or Codex, may require their own subscriptions or API plans.",
  },
  {
    q: "Does TermMate work with Sublime Text?",
    a: "Yes. TermMate installs through Package Control on Sublime Text and also ships a VS Code extension. In both editors it acts as a panel that hosts external coding-agent CLIs rather than providing its own agent.",
  },
  {
    q: "What is the main difference between Limitcode Pro and TermMate?",
    a: "Architecture. TermMate is a bridge: it docks third-party agent CLIs (Claude Code, Codex, OpenCode, Pi) into your editor, so behavior, approvals, and updates vary per agent. Limitcode Pro is a self-contained agent running natively inside Sublime Text, with one consistent workflow, permission model, and feature set.",
  },
  {
    q: "Do I need my own API key to use Limitcode Pro?",
    a: "You bring your own provider, and there are two ways to do it: direct API keys (OpenAI, Anthropic, Gemini, DeepSeek, OpenRouter, and any OpenAI-compatible endpoint) or account sign-in with GitHub Copilot, OpenAI Codex, or Google Antigravity. Local models through Ollama and LM Studio are supported too.",
  },
  {
    q: "Can Limitcode Pro run offline or with local models?",
    a: "Provider connections need internet access, but Limitcode Pro supports fully local setups through Ollama and LM Studio, so your code and prompts can stay on your machine while a local model does the work.",
  },
  {
    q: "Is there a free version of Limitcode?",
    a: "Yes. The open-source Limitcode edition is a free (GPL v3) pair-programming assistant that reads and edits files you have open in the editor. Limitcode Pro is the fully autonomous edition with project-wide tools, shell access, skills, MCP, and subagents.",
  },
];

const faqSchema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Article",
      headline: "Limitcode Pro vs TermMate: which Sublime Text AI agent fits your workflow?",
      description:
        "A detailed comparison of Limitcode Pro and TermMate for Sublime Text: architecture, providers, permissions, pricing, and day-to-day workflow.",
      datePublished: "2026-08-23",
      dateModified: "2026-08-23",
      author: { "@id": "https://jawuil.dev/#organization" },
      publisher: { "@id": "https://limitcode.jawuil.dev/#organization" },
      mainEntityOfPage: "https://limitcode.jawuil.dev/blog/limitcode-pro-vs-termmate/",
    },
    {
      "@type": "BreadcrumbList",
      itemListElement: [
        { "@type": "ListItem", position: 1, name: "Home", item: "https://limitcode.jawuil.dev/" },
        { "@type": "ListItem", position: 2, name: "Blog", item: "https://limitcode.jawuil.dev/blog/limitcode-pro-vs-termmate/" },
        { "@type": "ListItem", position: 3, name: "Limitcode Pro vs TermMate" },
      ],
    },
    {
      "@type": "FAQPage",
      mainEntity: faqs.map((f) => ({
        "@type": "Question",
        name: f.q,
        acceptedAnswer: { "@type": "Answer", text: f.a },
      })),
    },
  ],
};
---

<Layout
  title="Limitcode Pro vs TermMate: Sublime Text AI Agents Compared"
  description="TermMate or Limitcode Pro? We compare architecture, providers, permissions, and pricing for Sublime Text developers — and explain why a native agent beats a CLI bridge."
  canonicalPath="/blog/limitcode-pro-vs-termmate/"
>
  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} slot="head-extra" />
  <Nav />
  <main>
    <section class="post-hero">
      <div class="container">
        <span class="eyebrow reveal"><span class="dot"></span>Comparison · Aug 2026</span>
        <h1 class="reveal d1">Limitcode Pro vs TermMate</h1>
        <p class="lead reveal d2">
          Both bring AI agents to Sublime Text — and both are good at what they
          do. But they take opposite routes to get there: one hosts other
          tools' agents, the other <em>is</em> the agent. Here is how that
          difference plays out in daily work.
        </p>
      </div>
    </section>

    <section class="container">
      <div class="verdict reveal d3">
        <span class="verdict-label">Short answer</span>
        <p>
          <strong>TermMate</strong> is a free host that docks external
          coding-agent CLIs — Claude Code, Codex, OpenCode, Pi Agent — inside
          Sublime Text or VS Code. <strong>Limitcode Pro</strong> is a
          self-contained agent that lives in Sublime Text itself, connects
          straight to your provider of choice (including local models), and
          applies one consistent permission model to everything it does.
          If you want one install, one workflow, and predictable control,
          <a href="/#pricing">Limitcode Pro</a> is the more complete Sublime
          Text experience. If you already pay for Claude Code or Codex and
          just want them embedded in an editor, TermMate does exactly that.
        </p>
      </div>
    </section>

    <section class="post-section container" id="tldr">
      <div class="section-head">
        <span class="section-num">01 — At a glance</span>
        <h2>The short version.</h2>
      </div>
      <div class="table-wrap">
        <table class="cmp">
          <thead>
            <tr>
              <th scope="col"><span class="sr-only">Aspect</span></th>
              <th scope="col" class="col-pro">Limitcode Pro</th>
              <th scope="col">TermMate</th>
            </tr>
          </thead>
          <tbody>
            {tldr.map((row) => (
              <tr>
                <th scope="row">{row.label}</th>
                <td class="col-pro">{row.pro}</td>
                <td>{row.tm}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </section>

    <section class="post-section container" id="what-is-termmate">
      <div class="section-head">
        <span class="section-num">02 — The contender</span>
        <h2>What is TermMate?</h2>
        <p>
          TermMate is a package for Sublime Text and VS Code that embeds
          third-party coding agents — <a href="https://termmate.app/" target="_blank" rel="noopener">Claude Code, Codex, OpenCode, and Pi Agent</a> —
          in a chat panel inside your editor. It is free to install, keeps
          sessions across restarts, and ties each agent to your current window
          and folder.
        </p>
        <p>
          The important detail: the agent doing the work is never TermMate
          itself. It is whichever CLI you connected. Each one brings its own
          runtime, its own login, its own approval settings, and its own
          update cycle. TermMate's own feature matrix shows the seams — slash
          commands and sandbox mode exist only for Claude Code and Codex,
          thinking blocks only for Pi, MCP tools missing on Pi entirely.
          You manage the differences.
        </p>
      </div>
    </section>

    <section class="post-section container" id="what-is-limitcode">
      <div class="section-head">
        <span class="section-num">03 — The challenger</span>
        <h2>What is Limitcode Pro?</h2>
        <p>
          Limitcode Pro is a coding agent built to run inside Sublime Text —
          not a wrapper around somebody else's CLI. It searches across your
          project, proposes edits for your approval, runs shell commands under
          permission rules you configure, searches the web, loads skills,
          calls MCP servers, and spawns focused subagents. Everything happens
          in a side-by-side view of the editor you already use, with no daemon
          or separate service behind it.
        </p>
        <p>
          You connect the model layer yourself: API keys from OpenAI,
          Anthropic, Gemini, DeepSeek, OpenRouter, or any OpenAI-compatible
          endpoint — plus account sign-in with GitHub Copilot, OpenAI Codex,
          or Google Antigravity, and fully local models via Ollama and LM
          Studio. See the full list on the <a href="/providers/">Providers page</a>.
        </p>
      </div>
    </section>

    <section class="dark-section">
      <div class="container">
        <div class="section-head light">
          <span class="section-num">04 — The core difference</span>
          <h2>A bridge of CLIs vs a native agent.</h2>
          <p>
            With TermMate, your editor experience is only as consistent as the
            agents behind it: four CLIs means four runtimes to keep installed,
            four auth flows, four sets of approval semantics, and features
            that appear or disappear depending on which one is active.
          </p>
          <p>
            With Limitcode Pro, there is one runtime: the package inside
            Sublime Text. One permission model governs every file edit and
            command. Snapshots give you undo/redo over the agent's changes.
            Context compaction keeps long tasks coherent. And because the
            provider connection is direct, swapping models is a settings
            change — not a new toolchain.
          </p>
        </div>
      </div>
    </section>

    <section class="post-section container" id="features-compared">
      <div class="section-head">
        <span class="section-num">05 — Feature by feature</span>
        <h2>Side by side.</h2>
        <p>
          "Via agent" means the capability depends on which external CLI is
          connected and how it is configured. "Partial" reflects TermMate's
          published compatibility matrix.
        </p>
      </div>
      <div class="table-wrap">
        <table class="cmp cmp-tight">
          <thead>
            <tr>
              <th scope="col"><span class="sr-only">Feature</span></th>
              <th scope="col" class="col-pro">Limitcode Pro</th>
              <th scope="col">TermMate</th>
            </tr>
          </thead>
          <tbody>
            {features.map((row) => (
              <tr>
                <th scope="row">{row.f}</th>
                <td class="col-pro">{row.pro ? "✓" : "—"}</td>
                <td>
                  {row.tm === true ? "✓" : row.tm === false ? "—" : row.tm}
                </td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </section>

    <section class="post-section container" id="pricing-compared">
      <div class="section-head">
        <span class="section-num">06 — Pricing</span>
        <h2>Free vs one-time.</h2>
        <p>
          TermMate costs nothing up front — the bill arrives through whatever
          the hosted agents require, whether that is a Claude subscription, a
          ChatGPT plan, or API credits. Limitcode Pro is a
          <a href="/#pricing">one-time license valid on up to three devices</a>;
          after that, your provider bills you directly for what you actually
          use. If you prefer not to spend anything at all, the open-source
          Limitcode edition covers pair programming on files you have open.
        </p>
      </div>
    </section>

    <section class="post-section container" id="which-one">
      <div class="section-head">
        <span class="section-num">07 — The honest verdict</span>
        <h2>Which one should you pick?</h2>
      </div>
      <div class="pick-grid">
        <article class="pick-card">
          <h3>TermMate makes sense if…</h3>
          <ul>
            <li>You already subscribe to Claude Code or Codex and just want them docked in an editor.</li>
            <li>You split your week between VS Code and Sublime Text.</li>
            <li>You enjoy mixing agent harnesses and accept their quirks.</li>
          </ul>
        </article>
        <article class="pick-card pick-card-pro">
          <span class="pick-flag">Our pick for Sublime</span>
          <h3>Limitcode Pro makes sense if…</h3>
          <ul>
            <li>You want one install and one consistent agentic workflow in Sublime Text.</li>
            <li>You want to choose your model per task — cloud APIs, account sign-ins, or local models.</li>
            <li>You care about uniform permission rules and snapshot undo over every change.</li>
            <li>You would rather own a license than stack agent subscriptions.</li>
          </ul>
        </article>
      </div>
    </section>

    <section class="post-section container" id="faq">
      <div class="section-head">
        <span class="section-num">08 — FAQ</span>
        <h2>Questions people actually ask.</h2>
      </div>
      <div class="faq-list">
        {faqs.map((f) => (
          <details class="faq-item">
            <summary>{f.q}</summary>
            <p>{f.a}</p>
          </details>
        ))}
      </div>
    </section>

    <section class="container post-related-wrap">
      <aside class="related">
        <span class="related-label">Keep reading</span>
        <a href="/blog/limitcode-pro-vs-copilot">Limitcode Pro vs GitHub Copilot →</a>
        <a href="/blog/limitcode-pro-vs-pieces">Limitcode Pro vs Pieces →</a>
        <a href="/blog">All posts →</a>
      </aside>
    </section>

    <section class="container post-cta-wrap">
      <div class="about-cta">
        <div>
          <h3>Try the native route.</h3>
          <p>Limitcode Pro: a full coding agent inside the Sublime Text window you already have open.</p>
        </div>
        <div class="about-cta-links">
          <a class="btn btn-primary" href="/#pricing">Get Limitcode Pro <span class="arrow">→</span></a>
          <a class="btn btn-quiet" href="/docs">Read the docs →</a>
        </div>
      </div>
    </section>
  </main>
  <Footer />
</Layout>

<style>
  .post-hero {
    padding-top: clamp(64px, 8vw, 112px);
    padding-bottom: clamp(48px, 6vw, 80px);
  }

  .post-hero h1 {
    max-width: 16ch;
    margin: 18px 0 22px;
  }

  .lead {
    max-width: 58ch;
  }

  /* Verdict box */
  .verdict {
    border: 1px solid var(--hairline);
    border-left: 3px solid var(--signal);
    background: var(--paper-deep);
    padding: 28px 32px;
    max-width: 860px;
  }

  .verdict-label {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--signal);
  }

  .verdict p {
    margin-top: 12px;
    max-width: 68ch;
  }

  /* Sections */
  .post-section {
    padding-top: clamp(56px, 7vw, 96px);
    padding-bottom: clamp(24px, 3vw, 40px);
    border-top: 1px solid var(--hairline);
    margin-top: clamp(24px, 3vw, 40px);
  }

  .post-section .section-head p {
    max-width: 66ch;
  }

  .post-section .section-head p + p {
    margin-top: 12px;
  }

  /* Dark band */
  .dark-section {
    margin-top: clamp(24px, 3vw, 40px);
    padding-top: clamp(56px, 7vw, 96px);
    padding-bottom: clamp(56px, 7vw, 96px);
    background: var(--editor, #202B36);
    color: var(--paper);
    border-top: 1px solid var(--hairline);
  }

  .dark-section .light h2,
  .dark-section h2 {
    color: var(--paper);
  }

  .dark-section .section-num {
    color: rgba(243, 239, 229, 0.6);
  }

  .dark-section p {
    color: rgba(243, 239, 229, 0.78);
    max-width: 66ch;
    margin-top: 12px;
  }

  /* Tables */
  .table-wrap {
    overflow-x: auto;
    margin-top: clamp(28px, 4vw, 44px);
    border: 1px solid var(--hairline);
  }

  table.cmp {
    width: 100%;
    border-collapse: collapse;
    min-width: 560px;
  }

  table.cmp th,
  table.cmp td {
    text-align: left;
    padding: 14px 18px;
    border-bottom: 1px solid var(--hairline);
    vertical-align: top;
    font-size: 0.92rem;
  }

  table.cmp tbody tr:last-child th,
  table.cmp tbody tr:last-child td {
    border-bottom: none;
  }

  table.cmp thead th {
    font-family: var(--font-mono);
    font-size: 0.74rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--muted);
    background: var(--paper-deep);
  }

  table.cmp tbody th[scope="row"] {
    font-weight: 600;
    white-space: nowrap;
    color: var(--ink);
  }

  td.col-pro {
    border-left: 1px solid var(--hairline);
  }

  thead th.col-pro {
    color: var(--signal);
    box-shadow: inset 0 3px 0 var(--signal);
  }

  .cmp-tight th,
  .cmp-tight td {
    padding: 10px 18px;
  }

  /* Pick cards */
  .pick-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 18px;
    margin-top: clamp(32px, 5vw, 52px);
  }

  .pick-card {
    padding: 28px;
    border: 1px solid var(--hairline);
    background: var(--paper-deep);
  }

  .pick-card h3 {
    font-size: var(--step-1);
    margin-bottom: 16px;
  }

  .pick-card ul {
    padding-left: 18px;
    display: grid;
    gap: 10px;
  }

  .pick-card li {
    font-size: 0.92rem;
    color: var(--ink-soft);
  }

  .pick-card-pro {
    border-color: var(--signal);
    position: relative;
  }

  .pick-flag {
    position: absolute;
    top: -11px;
    left: 24px;
    background: var(--signal);
    color: #fff;
    font-family: var(--font-mono);
    font-size: 0.66rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    padding: 3px 10px;
  }

  /* FAQ */
  .faq-list {
    margin-top: clamp(28px, 4vw, 44px);
    max-width: 820px;
  }

  .faq-item {
    border-bottom: 1px solid var(--hairline);
  }

  .faq-item summary {
    cursor: pointer;
    font-weight: 600;
    padding: 18px 0;
    list-style-position: outside;
  }

  .faq-item p {
    padding-bottom: 20px;
    max-width: 64ch;
    color: var(--ink-soft);
  }

  /* Related posts */
  .post-related-wrap {
    margin-top: clamp(40px, 5vw, 72px);
  }

  .related {
    display: flex;
    align-items: center;
    gap: 24px;
    flex-wrap: wrap;
    padding: 20px 24px;
    border: 1px solid var(--hairline);
    background: var(--paper-deep);
  }

  .related-label {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--muted);
  }

  .related a {
    font-weight: 600;
  }

  /* CTA */
  .post-cta-wrap {
    margin-top: clamp(40px, 5vw, 72px);
    padding-bottom: clamp(64px, 8vw, 112px);
  }

  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  @media (max-width: 800px) {
    .pick-grid {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 640px) {
    .post-hero {
      padding-top: clamp(48px, 12vw, 72px);
    }

    .post-hero h1 {
      font-size: var(--step-3);
    }

    .verdict {
      padding: 22px 20px;
    }

    .post-section .section-head h2 {
      font-size: var(--step-3);
    }
  }
</style>
