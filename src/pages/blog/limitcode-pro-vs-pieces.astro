---
import Layout from "../../layouts/Layout.astro";
import Nav from "../../components/Nav.astro";
import Footer from "../../components/Footer.astro";

const tldr = [
  {
    label: "What it is",
    pro: "A coding agent that works inside Sublime Text",
    tm: "A memory layer that records your work across apps",
  },
  {
    label: "How it helps",
    pro: "It acts: edits files, runs approved commands, searches the web",
    tm: "It recalls: searchable timeline of what you already saw and copied",
  },
  {
    label: "Background process",
    pro: "None — it works when you ask",
    tm: "Runs constantly, forming memories every ~2 seconds",
  },
  {
    label: "Data handling",
    pro: "Permission-gated access to your project only",
    tm: "Continuous screen & clipboard capture, stored on-device",
  },
  {
    label: "Editor focus",
    pro: "Native Sublime Text 4 side-by-side view",
    tm: "Desktop app + integrations (VS Code, JetBrains, Xcode) + MCP",
  },
  {
    label: "Models",
    pro: "Your own API keys, account sign-ins, or local models",
    tm: "Claude, Gemini, ChatGPT and local models under one plan",
  },
  {
    label: "Price",
    pro: "One-time license, up to 3 devices",
    tm: "$18.99/user/month after a 7-day trial",
  },
];

const features = [
  { f: "Edits project files", pro: true, pc: false },
  { f: "Runs approved shell commands", pro: true, pc: false },
  { f: "Project-wide code search", pro: true, pc: false },
  { f: "Web search", pro: true, pc: false },
  { f: "Skills and subagents", pro: true, pc: false },
  { f: "Snapshot undo/redo of changes", pro: true, pc: false },
  { f: "MCP support", pro: true, pc: true },
  { f: "Local model option", pro: true, pc: true },
  { f: "Consistent permission rules", pro: true, pc: false },
  { f: "No daemon running all day", pro: true, pc: false },
  { f: "Screen activity timeline", pro: false, pc: true },
  { f: "Clipboard history", pro: false, pc: true },
  { f: "Meeting capture (opt-in)", pro: false, pc: true },
  { f: "Recall across every app", pro: false, pc: true },
  { f: "Auto-generated standups and briefs", pro: false, pc: true },
];

const faqs = [
  {
    q: "Is Pieces free?",
    a: "No. Pieces offers a 7-day free trial (card required), then Pro costs $18.99 per user per month billed monthly — around 25% less on yearly billing. An Enterprise plan costs $22.99 per user per month with org-wide controls.",
  },
  {
    q: "Does Pieces work with Sublime Text?",
    a: "Pieces' website highlights integrations with editors like VS Code, JetBrains IDEs and Xcode, plus an MCP server that carries your history into MCP-ready assistants such as Claude, Cursor and Codex. It does not provide a native agentic workflow inside Sublime Text — that is what Limitcode Pro does.",
  },
  {
    q: "Is Pieces private?",
    a: "Pieces stores memories on your device by default and offers pause controls plus deletion by time range, app or capture method. Still, its core design is continuous capture — it records the focused window and clipboard every couple of seconds unless paused. Limitcode Pro takes the opposite approach: zero background processes, and it only touches your project under permission rules you configure.",
  },
  {
    q: "What is the difference between Pieces and a coding agent?",
    a: "Direction of action. Pieces looks backward: it captures what happened so you can search and summarize it later. A coding agent like Limitcode Pro looks forward: you give it a task and it inspects your project, proposes edits, and runs approved commands to finish it.",
  },
  {
    q: "Can I use Limitcode Pro and Pieces together?",
    a: "Yes — they are complementary rather than competing. Pieces can act as your memory layer and feed context through MCP, while Limitcode Pro executes the actual code changes inside Sublime Text. If you only adopt one to improve how you ship code in Sublime Text, choose the one that edits code: Limitcode Pro.",
  },
  {
    q: "Which one is cheaper long term?",
    a: "Pieces is a subscription: $18.99 per user per month is roughly $228 per year, indefinitely. Limitcode Pro is a one-time purchase valid on up to three devices, with usage costs paid directly to your chosen provider. There is also a free open-source Limitcode edition for pair programming.",
  },
];

const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Article",
      headline: "Limitcode Pro vs Pieces: a coding agent or a memory layer?",
      description:
        "Pieces records everything you do across apps; Limitcode Pro acts on your code inside Sublime Text. We compare architecture, privacy, pricing, and workflow.",
      datePublished: "2026-08-23",
      dateModified: "2026-08-23",
      author: { "@id": "https://jawuil.dev/#organization" },
      publisher: { "@id": "https://limitcode.jawuil.dev/#organization" },
      mainEntityOfPage: "https://limitcode.jawuil.dev/blog/limitcode-pro-vs-pieces/",
    },
    {
      "@type": "BreadcrumbList",
      itemListElement: [
        { "@type": "ListItem", position: 1, name: "Home", item: "https://limitcode.jawuil.dev/" },
        { "@type": "ListItem", position: 2, name: "Blog", item: "https://limitcode.jawuil.dev/blog/" },
        { "@type": "ListItem", position: 3, name: "Limitcode Pro vs Pieces" },
      ],
    },
    {
      "@type": "FAQPage",
      mainEntity: faqs.map((f) => ({
        "@type": "Question",
        name: f.q,
        acceptedAnswer: { "@type": "Answer", text: f.a },
      })),
    },
  ],
};
---

<Layout
  title="Limitcode Pro vs Pieces: Memory Layer or Coding Agent?"
  description="Pieces records everything you do across your apps; Limitcode Pro acts on your code inside Sublime Text. Compare architecture, privacy, and pricing."
  canonicalPath="/blog/limitcode-pro-vs-pieces/"
>
  <script type="application/ld+json" set:html={JSON.stringify(schema)} slot="head-extra" />
  <Nav />
  <main>
    <section class="post-hero">
      <div class="container">
        <span class="eyebrow reveal"><span class="dot"></span>Comparison · Aug 2026</span>
        <h1 class="reveal d1">Limitcode Pro vs Pieces</h1>
        <p class="lead reveal d2">
          These two are not really rivals — one remembers your work, the other
          does it. That difference decides everything: how they run, what they
          touch on your machine, and what you pay. Here is the full picture.
        </p>
      </div>
    </section>

    <section class="container">
      <div class="verdict reveal d3">
        <span class="verdict-label">Short answer</span>
        <p>
          <strong>Pieces</strong> is a passive memory layer: it runs in the
          background capturing your screens and clipboard, then lets you search,
          ask, and auto-write summaries about what already happened.
          <strong>Limitcode Pro</strong> is an active agent: give it a task and
          it searches your project, proposes edits, and runs approved commands
          inside Sublime Text. If you want to <em>ship code</em> from the editor
          you already use, <a href="/#pricing">Limitcode Pro</a> is the tool
          that actually does the work. Pieces shines later — as an optional
          recall layer on top of whatever you produce.
        </p>
      </div>
    </section>

    <section class="post-section container" id="tldr">
      <div class="section-head">
        <span class="section-num">01 — At a glance</span>
        <h2>The short version.</h2>
      </div>
      <div class="table-wrap">
        <table class="cmp">
          <thead>
            <tr>
              <th scope="col"><span class="sr-only">Aspect</span></th>
              <th scope="col" class="col-pro">Limitcode Pro</th>
              <th scope="col">Pieces</th>
            </tr>
          </thead>
          <tbody>
            {tldr.map((row) => (
              <tr>
                <th scope="row">{row.label}</th>
                <td class="col-pro">{row.pro}</td>
                <td>{row.tm}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </section>

    <section class="post-section container" id="what-is-pieces">
      <div class="section-head">
        <span class="section-num">02 — The contender</span>
        <h2>What is Pieces?</h2>
        <p>
          <a href="https://pieces.app/" target="_blank" rel="noopener">Pieces</a> calls
          itself "the memory layer for everything you do". A desktop app runs in
          the background and forms memories roughly every two seconds from the
          focused application and your clipboard — browsers, email, Slack, Notion,
          Figma, AI chats, IDEs. Audio capture from meetings exists too, opt-in.
          Everything is stored locally on your machine.
        </p>
        <p>
          On top of that timeline you get conversational search scoped by time,
          person, topic or source, plus one-click artifacts: standup updates,
          morning briefs, meeting prep, day recaps. Through the Pieces MCP
          Server, that history can be pulled into MCP-ready tools like Claude,
          Cursor or Codex. It is a genuinely useful idea — for remembering.
          Nothing in Pieces edits your code or runs your commands.
        </p>
      </div>
    </section>

    <section class="post-section container" id="what-is-limitcode">
      <div class="section-head">
        <span class="section-num">03 — The challenger</span>
        <h2>What is Limitcode Pro?</h2>
        <p>
          Limitcode Pro is a coding agent that lives inside Sublime Text — not a
          recorder, a worker. Ask for a task and it searches across your project,
          proposes targeted edits for approval, runs shell commands under
          permission rules, searches the web, loads skills, calls MCP servers,
          and spawns focused subagents — all in a side-by-side view, with no
          daemon or separate service behind it.
        </p>
        <p>
          You bring the intelligence: API keys from OpenAI, Anthropic, Gemini,
          DeepSeek, OpenRouter or any OpenAI-compatible endpoint, account
          sign-in with GitHub Copilot, OpenAI Codex or Google Antigravity — or
          fully local models via Ollama and LM Studio. Snapshots give you
          undo/redo over every change the agent makes. Full details on the
          <a href="/providers/">Providers page</a>.
        </p>
      </div>
    </section>

    <section class="dark-section">
      <div class="container">
        <div class="section-head light">
          <span class="section-num">04 — The core difference</span>
          <h2>A camera over your day vs hands in your editor.</h2>
          <p>
            Pieces watches everything and changes nothing. To build its value it
            must run constantly — capturing the focused window and clipboard
            every couple of seconds, storing it all on-device. That is its
            product, and it earns real privacy credit for keeping data local and
            giving you kill switches. But the model is inherently
            record-everything-first, ask-later.
          </p>
          <p>
            Limitcode Pro inverts it: zero background processes. When you ask
            for a task, it reads exactly what the task needs from your project,
            under configurable permission rules, shows you each proposed edit
            and command, and keeps snapshots so nothing is irreversible. It
            never needs to see your browser tabs, your inbox, or your Slack to
            be useful — because its job is moving your code forward, not
            narrating your past.
          </p>
        </div>
      </div>
    </section>

    <section class="post-section container" id="features-compared">
      <div class="section-head">
        <span class="section-num">05 — Feature by feature</span>
        <h2>Side by side.</h2>
      </div>
      <div class="table-wrap">
        <table class="cmp cmp-tight">
          <thead>
            <tr>
              <th scope="col"><span class="sr-only">Feature</span></th>
              <th scope="col" class="col-pro">Limitcode Pro</th>
              <th scope="col">Pieces</th>
            </tr>
          </thead>
          <tbody>
            {features.map((row) => (
              <tr>
                <th scope="row">{row.f}</th>
                <td class="col-pro">{row.pro ? "✓" : "—"}</td>
                <td>{row.pc ? "✓" : "—"}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </section>

    <section class="post-section container" id="pricing-compared">
      <div class="section-head">
        <span class="section-num">06 — Pricing</span>
        <h2>Subscription vs one-time.</h2>
        <p>
          Pieces Pro costs $18.99 per user per month (billed monthly; about 25%
          less on yearly billing) after a 7-day trial, and Enterprise is
          $22.99 per user per month. That is roughly $170–$230 per user, every
          year, forever. Limitcode Pro is a
          <a href="/#pricing">one-time license valid on up to three devices</a> —
          after that, your provider bills you directly for what you use, at
          cost. And the open-source Limitcode edition stays free for pair
          programming on files you have open.
        </p>
      </div>
    </section>

    <section class="post-section container" id="which-one">
      <div class="section-head">
        <span class="section-num">07 — The honest verdict</span>
        <h2>Which one should you pick?</h2>
      </div>
      <div class="pick-grid">
        <article class="pick-card">
          <h3>Pieces makes sense if…</h3>
          <ul>
            <li>Your day spans many apps and you want to recall anything you saw or copied.</li>
            <li>You want auto-generated standups, briefs, and recaps from real activity.</li>
            <li>Your team wants shared context and org-wide capture policies.</li>
          </ul>
        </article>
        <article class="pick-card pick-card-pro">
          <span class="pick-flag">Our pick for shipping code</span>
          <h3>Limitcode Pro makes sense if…</h3>
          <ul>
            <li>You want Sublime Text itself to edit files and run commands for you.</li>
            <li>You prefer an agent that acts only on request — nothing recording in the background.</li>
            <li>You want your choice of cloud or local models under your own keys.</li>
            <li>You would rather pay once than add another monthly subscription.</li>
          </ul>
        </article>
      </div>
    </section>

    <section class="post-section container" id="faq">
      <div class="section-head">
        <span class="section-num">08 — FAQ</span>
        <h2>Questions people actually ask.</h2>
      </div>
      <div class="faq-list">
        {faqs.map((f) => (
          <details class="faq-item">
            <summary>{f.q}</summary>
            <p>{f.a}</p>
          </details>
        ))}
      </div>
    </section>

    <section class="container post-related-wrap">
      <aside class="related">
        <span class="related-label">Keep reading</span>
        <a href="/blog/limitcode-pro-vs-termmate">Limitcode Pro vs TermMate →</a>
        <a href="/blog/limitcode-pro-vs-copilot">Limitcode Pro vs GitHub Copilot →</a>
        <a href="/blog">All posts →</a>
      </aside>
    </section>

    <section class="container post-cta-wrap">
      <div class="about-cta">
        <div>
          <h3>Don't just remember the work. Do it.</h3>
          <p>Limitcode Pro: a full coding agent inside the Sublime Text window you already have open.</p>
        </div>
        <div class="about-cta-links">
          <a class="btn btn-primary" href="/#pricing">Get Limitcode Pro <span class="arrow">→</span></a>
          <a class="btn btn-quiet" href="/docs">Read the docs →</a>
        </div>
      </div>
    </section>
  </main>
  <Footer />
</Layout>

<style>
  .post-hero {
    padding-top: clamp(64px, 8vw, 112px);
    padding-bottom: clamp(48px, 6vw, 80px);
  }

  .post-hero h1 {
    max-width: 16ch;
    margin: 18px 0 22px;
  }

  .lead {
    max-width: 58ch;
  }

  .verdict {
    border: 1px solid var(--hairline);
    border-left: 3px solid var(--signal);
    background: var(--paper-deep);
    padding: 28px 32px;
    max-width: 860px;
  }

  .verdict-label {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--signal);
  }

  .verdict p {
    margin-top: 12px;
    max-width: 68ch;
  }

  .post-section {
    padding-top: clamp(56px, 7vw, 96px);
    padding-bottom: clamp(24px, 3vw, 40px);
    border-top: 1px solid var(--hairline);
    margin-top: clamp(24px, 3vw, 40px);
  }

  .post-section .section-head p {
    max-width: 66ch;
  }

  .post-section .section-head p + p {
    margin-top: 12px;
  }

  .dark-section {
    margin-top: clamp(24px, 3vw, 40px);
    padding-top: clamp(56px, 7vw, 96px);
    padding-bottom: clamp(56px, 7vw, 96px);
    background: var(--editor);
    border-top: 1px solid var(--hairline);
  }

  .dark-section h2 {
    color: var(--paper);
  }

  .dark-section .section-num {
    color: rgba(243, 239, 229, 0.6);
  }

  .dark-section p {
    color: rgba(243, 239, 229, 0.78);
    max-width: 66ch;
    margin-top: 12px;
  }

  .table-wrap {
    overflow-x: auto;
    margin-top: clamp(28px, 4vw, 44px);
    border: 1px solid var(--hairline);
  }

  table.cmp {
    width: 100%;
    border-collapse: collapse;
    min-width: 560px;
  }

  table.cmp th,
  table.cmp td {
    text-align: left;
    padding: 14px 18px;
    border-bottom: 1px solid var(--hairline);
    vertical-align: top;
    font-size: 0.92rem;
  }

  table.cmp tbody tr:last-child th,
  table.cmp tbody tr:last-child td {
    border-bottom: none;
  }

  table.cmp thead th {
    font-family: var(--font-mono);
    font-size: 0.74rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--muted);
    background: var(--paper-deep);
  }

  table.cmp tbody th[scope="row"] {
    font-weight: 600;
    white-space: nowrap;
    color: var(--ink);
  }

  td.col-pro {
    border-left: 1px solid var(--hairline);
  }

  thead th.col-pro {
    color: var(--signal);
    box-shadow: inset 0 3px 0 var(--signal);
  }

  .cmp-tight th,
  .cmp-tight td {
    padding: 10px 18px;
  }

  .pick-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 18px;
    margin-top: clamp(32px, 5vw, 52px);
  }

  .pick-card {
    padding: 28px;
    border: 1px solid var(--hairline);
    background: var(--paper-deep);
  }

  .pick-card h3 {
    font-size: var(--step-1);
    margin-bottom: 16px;
  }

  .pick-card ul {
    padding-left: 18px;
    display: grid;
    gap: 10px;
  }

  .pick-card li {
    font-size: 0.92rem;
    color: var(--ink-soft);
  }

  .pick-card-pro {
    border-color: var(--signal);
    position: relative;
  }

  .pick-flag {
    position: absolute;
    top: -11px;
    left: 24px;
    background: var(--signal);
    color: #fff;
    font-family: var(--font-mono);
    font-size: 0.66rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    padding: 3px 10px;
  }

  .faq-list {
    margin-top: clamp(28px, 4vw, 44px);
    max-width: 820px;
  }

  .faq-item {
    border-bottom: 1px solid var(--hairline);
  }

  .faq-item summary {
    cursor: pointer;
    font-weight: 600;
    padding: 18px 0;
    list-style-position: outside;
  }

  .faq-item p {
    padding-bottom: 20px;
    max-width: 64ch;
    color: var(--ink-soft);
  }

  .post-related-wrap {
    margin-top: clamp(40px, 5vw, 72px);
  }

  .related {
    display: flex;
    align-items: center;
    gap: 24px;
    flex-wrap: wrap;
    padding: 20px 24px;
    border: 1px solid var(--hairline);
    background: var(--paper-deep);
  }

  .related-label {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--muted);
  }

  .related a {
    font-weight: 600;
  }

  .post-cta-wrap {
    margin-top: clamp(24px, 3vw, 40px);
    padding-bottom: clamp(64px, 8vw, 112px);
  }

  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  @media (max-width: 800px) {
    .pick-grid {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 640px) {
    .post-hero {
      padding-top: clamp(48px, 12vw, 72px);
    }

    .post-hero h1 {
      font-size: var(--step-3);
    }

    .verdict {
      padding: 22px 20px;
    }

    .post-section .section-head h2 {
      font-size: var(--step-3);
    }
  }
</style>
