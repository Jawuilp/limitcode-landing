---
import Layout from "../../layouts/Layout.astro";
import Nav from "../../components/Nav.astro";
import Footer from "../../components/Footer.astro";

const tldr = [
  {
    label: "What it is",
    pro: "A coding agent that works inside Sublime Text",
    tm: "Anthropic's terminal-first coding agent",
  },
  {
    label: "Where it lives",
    pro: "A native side-by-side Sublime Text view",
    tm: "The terminal (also web and desktop apps)",
  },
  {
    label: "Sublime Text integration",
    pro: "Native, first-class",
    tm: "None official — community bridges host the CLI in a panel",
  },
  {
    label: "Models",
    pro: "OpenAI, Anthropic, Gemini, Copilot, DeepSeek, OpenRouter, or local models",
    tm: "Claude models (Sonnet, Opus, Haiku) via Anthropic's plans or API",
  },
  {
    label: "Provider choice",
    pro: "Bring your own keys or accounts, switch per task",
    tm: "Anthropic's ecosystem (API, Bedrock, Vertex)",
  },
  {
    label: "Setup",
    pro: "Install the package, connect a provider",
    tm: "Install the CLI (Node.js), then work in a terminal",
  },
  {
    label: "Price",
    pro: "One-time license, up to 3 devices; provider usage at cost",
    tm: "Pro $20/mo, Max 5x $100/mo, Max 20x $200/mo, or pay-per-token API",
  },
];

const features = [
  { f: "Native Sublime Text support", pro: true, tm: false },
  { f: "Runs without an external CLI or bridge process", pro: true, tm: false },
  { f: "Agent reads, edits, and runs approved commands", pro: true, tm: true },
  { f: "MCP servers", pro: true, tm: true },
  { f: "Skills and subagents", pro: true, tm: true },
  { f: "Web search and URL fetching", pro: true, tm: true },
  { f: "Multi-provider: switch models per task", pro: true, tm: false },
  { f: "Local models (Ollama, LM Studio)", pro: true, tm: false },
  { f: "Claude models available", pro: true, tm: true },
  { f: "Configurable per-tool permission rules", pro: true, tm: "permission modes" },
  { f: "Snapshot undo/redo of agent edits", pro: true, tm: "checkpoint rewind" },
  { f: "One-time license (no monthly subscription)", pro: true, tm: false },
];

const faqs = [
  {
    q: "Does Claude Code work with Sublime Text?",
    a: "Not natively. Claude Code is a terminal-first agent — there is no official Sublime Text plugin. Community projects (such as TermMate or bridge plugins) can host the Claude Code CLI inside an editor panel, but that means running the CLI plus a bridge process and authenticating the CLI separately. Limitcode Pro is a Sublime Text package: the agent runs inside the editor with no CLI or bridge required.",
  },
  {
    q: "Can I use Claude models inside Limitcode Pro?",
    a: "Yes. Limitcode Pro connects to Anthropic's API directly with your own key, so you can keep Claude as the model while the agent lives inside Sublime Text. You can also switch to OpenAI, Gemini, DeepSeek, OpenRouter, Copilot, or local models per task.",
  },
  {
    q: "How much does Claude Code cost?",
    a: "There is no free plan. Claude Code is included with Claude Pro ($20/month), Max 5x ($100/month), and Max 20x ($200/month), with usage windows that reset every 5 hours. Alternatively it runs pay-per-token on the Anthropic API. Limitcode Pro is a one-time license valid on up to three devices; model usage is paid directly to whichever provider you choose, at cost.",
  },
  {
    q: "What is the main difference between Limitcode Pro and Claude Code?",
    a: "Where the agent lives and who provides the models. Claude Code is excellent for terminal-first developers who are all-in on Anthropic. Limitcode Pro is for developers who want the agent inside the Sublime Text window they already have open, with the freedom to route every task to a different provider — including Claude, or fully local models.",
  },
  {
    q: "Can I use both?",
    a: "Yes, and many developers do. Terminal loops and editor-native agents solve different problems. If you want to try the editor-first workflow without giving up your terminal tools, Limitcode Pro runs entirely inside Sublime Text and does not conflict with a Claude Code install.",
  },
];

const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Article",
      headline: "Limitcode Pro vs Claude Code: Sublime Text Agent vs Terminal CLI",
      description:
        "Claude Code is a terminal-first agent with no official Sublime Text plugin; Limitcode Pro is built for Sublime Text with any provider you choose. Pricing, models, and workflow compared.",
      datePublished: "2026-08-27",
      dateModified: "2026-08-27",
      author: { "@id": "https://jawuil.dev/#organization" },
      publisher: { "@id": "https://limitcode.jawuil.dev/#organization" },
      mainEntityOfPage: "https://limitcode.jawuil.dev/blog/limitcode-pro-vs-claude-code/",
    },
    {
      "@type": "BreadcrumbList",
      itemListElement: [
        { "@type": "ListItem", position: 1, name: "Home", item: "https://limitcode.jawuil.dev/" },
        { "@type": "ListItem", position: 2, name: "Blog", item: "https://limitcode.jawuil.dev/blog/" },
        { "@type": "ListItem", position: 3, name: "Limitcode Pro vs Claude Code" },
      ],
    },
    {
      "@type": "FAQPage",
      mainEntity: faqs.map((f) => ({
        "@type": "Question",
        name: f.q,
        acceptedAnswer: { "@type": "Answer", text: f.a },
      })),
    },
  ],
};
---

<Layout
  title="Limitcode Pro vs Claude Code: Sublime Text Agent vs Terminal CLI"
  description="Claude Code is a terminal-first agent with no official Sublime Text plugin; Limitcode Pro is built for Sublime Text with any provider you choose. Pricing, models, and workflow compared."
  canonicalPath="/blog/limitcode-pro-vs-claude-code/"
>
  <script type="application/ld+json" set:html={JSON.stringify(schema)} slot="head-extra" />
  <Nav />
  <main>
    <section class="post-hero">
      <div class="container">
        <span class="eyebrow reveal"><span class="dot"></span>Comparison · Aug 2026</span>
        <h1 class="reveal d1">Limitcode Pro vs Claude Code</h1>
        <p class="lead reveal d2">
          Claude Code is one of the best terminal agents ever shipped — if your
          workflow lives in the terminal. If your workflow lives in Sublime
          Text, the comparison looks very different.
        </p>
      </div>
    </section>

    <section class="container">
      <div class="verdict reveal d3">
        <span class="verdict-label">Short answer</span>
        <p>
          <strong>Claude Code</strong> is excellent for terminal-first workflows
          — and Limitcode is not trying to pretend otherwise. It is Anthropic's
          agent, locked to Claude models, billed monthly ($20–$200/mo or
          pay-per-token), and it has no official Sublime Text integration.
          <strong>Limitcode Pro</strong> is a lightweight agent that runs
          natively inside Sublime Text, connects to any provider with your own
          keys — including Claude — and is a one-time license. If you live in
          the terminal, Claude Code may be the better fit. If you want to stay
          inside Sublime, <a href="/#pricing">Limitcode Pro</a> is designed for
          exactly that.
        </p>
      </div>
    </section>

    <section class="post-section container" id="tldr">
      <div class="section-head">
        <span class="section-num">01 — At a glance</span>
        <h2>The short version.</h2>
      </div>
      <div class="table-wrap">
        <table class="cmp">
          <thead>
            <tr>
              <th scope="col"><span class="sr-only">Aspect</span></th>
              <th scope="col" class="col-pro">Limitcode Pro</th>
              <th scope="col">Claude Code</th>
            </tr>
          </thead>
          <tbody>
            {tldr.map((row) => (
              <tr>
                <th scope="row">{row.label}</th>
                <td class="col-pro">{row.pro}</td>
                <td>{row.tm}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </section>

    <section class="post-section container" id="what-is-claude-code">
      <div class="section-head">
        <span class="section-num">02 — The contender</span>
        <h2>What is Claude Code?</h2>
        <p>
          <a href="https://claude.com/claude-code" target="_blank" rel="noopener">Claude Code</a>
          is Anthropic's agentic coding tool. It runs in your terminal, reads
          your codebase, edits files, executes commands, and supports MCP
          servers, hooks, project instructions, and subagents. It is also
          available through web and desktop apps. For terminal-first developers
          who primarily want Claude models, it is a superb tool.
        </p>
        <p>
          It is tied to Anthropic's ecosystem: Claude models only, accessed
          through a Claude subscription (Pro, Max 5x, Max 20x) or the
          pay-per-token API. There is no official Sublime Text plugin; editor
          panels that show Claude Code inside Sublime do it by hosting the CLI
          through a bridge process.
        </p>
      </div>
    </section>

    <section class="post-section container" id="what-is-limitcode">
      <div class="section-head">
        <span class="section-num">03 — The challenger</span>
        <h2>What is Limitcode Pro?</h2>
        <p>
          Limitcode Pro is a lightweight coding agent that lives inside Sublime
          Text (builds 4050+) — no separate AI IDE, and no separate agent daemon
          required for direct API providers. In a side-by-side chat view it
          inspects project files, proposes targeted edits for approval, runs
          approved shell commands, searches the web, loads skills, calls MCP
          servers, and runs focused subagents under configurable permission
          rules.
        </p>
        <p>
          You choose the model layer per task: API keys from OpenAI, Anthropic,
          Gemini, DeepSeek, or OpenRouter; account sign-in with Copilot, Codex,
          or Antigravity; or fully local models via Ollama and LM Studio. Agent
          edits receive snapshots for undo/redo during the session. Details on
          the <a href="/providers/">Providers page</a>.
        </p>
      </div>
    </section>

    <section class="dark-section">
      <div class="container">
        <div class="section-head light">
          <span class="section-num">04 — The core difference</span>
          <h2>Terminal-first vs editor-first.</h2>
          <p>
            Claude Code assumes the terminal is home. You keep your editor open
            in one place and talk to the agent in a shell — copying context
            between the two when you need to. That loop is natural if you
            already work that way, and Anthropic keeps making it better.
          </p>
          <p>
            Limitcode Pro removes the loop. The agent works in the Sublime
            window you already have open: send the current selection or file
            with one shortcut, review approved edits in place, and keep LSP
            diagnostics part of the loop. It is not a wrapper around a CLI — it
            is a native package, and it is not trying to replace every
            terminal-first workflow.
          </p>
        </div>
      </div>
    </section>

    <section class="post-section container" id="features-compared">
      <div class="section-head">
        <span class="section-num">05 — Feature by feature</span>
        <h2>Side by side.</h2>
      </div>
      <div class="table-wrap">
        <table class="cmp cmp-tight">
          <thead>
            <tr>
              <th scope="col"><span class="sr-only">Feature</span></th>
              <th scope="col" class="col-pro">Limitcode Pro</th>
              <th scope="col">Claude Code</th>
            </tr>
          </thead>
          <tbody>
            {features.map((row) => (
              <tr>
                <th scope="row">{row.f}</th>
                <td class="col-pro">{row.pro === true ? "✓" : row.pro}</td>
                <td>{row.tm === true ? "✓" : row.tm === false ? "—" : row.tm}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </section>

    <section class="post-section container" id="pricing-compared">
      <div class="section-head">
        <span class="section-num">06 — Pricing</span>
        <h2>Subscription vs one-time.</h2>
        <p>
          Claude Code requires an Anthropic plan: Pro at $20/month, Max 5x at
          $100/month, Max 20x at $200/month — with usage windows that reset
          every 5 hours — or pay-per-token through the API. There is no free
          tier. Limitcode Pro is a <a href="/#pricing">one-time license valid on
          up to three devices</a>; you pay your chosen provider only for what you
          use, at cost — Anthropic included. The open-source Limitcode edition
          remains free for pair programming.
        </p>
      </div>
    </section>

    <section class="post-section container" id="which-one">
      <div class="section-head">
        <span class="section-num">07 — The honest verdict</span>
        <h2>Which one should you pick?</h2>
      </div>
      <div class="pick-grid">
        <article class="pick-card">
          <h3>Claude Code makes sense if…</h3>
          <ul>
            <li>Your workflow is terminal-first and you are happy there.</li>
            <li>You are all-in on Claude models and want the deepest Anthropic integration.</li>
            <li>You want the same agent in the terminal, web, and desktop.</li>
            <li>A monthly subscription fits how you already pay for tools.</li>
          </ul>
        </article>
        <article class="pick-card pick-card-pro">
          <span class="pick-flag">Our pick for Sublime Text</span>
          <h3>Limitcode Pro makes sense if…</h3>
          <ul>
            <li>You write code in Sublime Text and want the agent to live there.</li>
            <li>You want provider freedom: Claude today, Gemini or a local model tomorrow.</li>
            <li>You prefer a one-time license over a subscription.</li>
            <li>You want permission rules, snapshot undo/redo, and editor-native tools like Send to Agent.</li>
          </ul>
        </article>
      </div>
    </section>

    <section class="post-section container" id="faq">
      <div class="section-head">
        <span class="section-num">08 — FAQ</span>
        <h2>Questions people actually ask.</h2>
      </div>
      <div class="faq-list">
        {faqs.map((f) => (
          <details class="faq-item">
            <summary>{f.q}</summary>
            <p>{f.a}</p>
          </details>
        ))}
      </div>
    </section>

    <section class="container post-related-wrap">
      <aside class="related">
        <span class="related-label">Keep reading</span>
        <a href="/blog/limitcode-pro-vs-opencode">Limitcode Pro vs OpenCode →</a>
        <a href="/blog/limitcode-pro-vs-cursor">Limitcode Pro vs Cursor →</a>
        <a href="/blog">All posts →</a>
      </aside>
    </section>

    <section class="container post-cta-wrap">
      <div class="about-cta">
        <div>
          <h3>The lightweight agent for Sublime Text.</h3>
          <p>Limitcode Pro: a full coding agent inside the Sublime Text window you already have open.</p>
        </div>
        <div class="about-cta-links">
          <a class="btn btn-primary" href="/#pricing">Get Limitcode Pro <span class="arrow">→</span></a>
          <a class="btn btn-quiet" href="/docs">Read the docs →</a>
        </div>
      </div>
    </section>
  </main>
  <Footer />
</Layout>

<style>
  .post-hero {
    padding-top: clamp(64px, 8vw, 112px);
    padding-bottom: clamp(48px, 6vw, 80px);
  }

  .post-hero h1 {
    max-width: 16ch;
    margin: 18px 0 22px;
  }

  .lead {
    max-width: 58ch;
  }

  .verdict {
    border: 1px solid var(--hairline);
    border-left: 3px solid var(--signal);
    background: var(--paper-deep);
    padding: 28px 32px;
    max-width: 860px;
  }

  .verdict-label {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--signal);
  }

  .verdict p {
    margin-top: 12px;
    max-width: 68ch;
  }

  .post-section {
    padding-top: clamp(56px, 7vw, 96px);
    padding-bottom: clamp(24px, 3vw, 40px);
    border-top: 1px solid var(--hairline);
    margin-top: clamp(24px, 3vw, 40px);
  }

  .post-section .section-head p {
    max-width: 66ch;
  }

  .post-section .section-head p + p {
    margin-top: 12px;
  }

  .dark-section {
    margin-top: clamp(24px, 3vw, 40px);
    padding-top: clamp(56px, 7vw, 96px);
    padding-bottom: clamp(56px, 7vw, 96px);
    background: var(--editor);
    border-top: 1px solid var(--hairline);
  }

  .dark-section h2 {
    color: var(--paper);
  }

  .dark-section .section-num {
    color: rgba(243, 239, 229, 0.6);
  }

  .dark-section p {
    color: rgba(243, 239, 229, 0.78);
    max-width: 66ch;
    margin-top: 12px;
  }

  .table-wrap {
    overflow-x: auto;
    margin-top: clamp(28px, 4vw, 44px);
    border: 1px solid var(--hairline);
  }

  table.cmp {
    width: 100%;
    border-collapse: collapse;
    min-width: 560px;
  }

  table.cmp th,
  table.cmp td {
    text-align: left;
    padding: 14px 18px;
    border-bottom: 1px solid var(--hairline);
    vertical-align: top;
    font-size: 0.92rem;
  }

  table.cmp tbody tr:last-child th,
  table.cmp tbody tr:last-child td {
    border-bottom: none;
  }

  table.cmp thead th {
    font-family: var(--font-mono);
    font-size: 0.74rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--muted);
    background: var(--paper-deep);
  }

  table.cmp tbody th[scope="row"] {
    font-weight: 600;
    white-space: nowrap;
    color: var(--ink);
  }

  td.col-pro {
    border-left: 1px solid var(--hairline);
  }

  thead th.col-pro {
    color: var(--signal);
    box-shadow: inset 0 3px 0 var(--signal);
  }

  .cmp-tight th,
  .cmp-tight td {
    padding: 10px 18px;
  }

  .pick-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 18px;
    margin-top: clamp(32px, 5vw, 52px);
  }

  .pick-card {
    padding: 28px;
    border: 1px solid var(--hairline);
    background: var(--paper-deep);
  }

  .pick-card h3 {
    font-size: var(--step-1);
    margin-bottom: 16px;
  }

  .pick-card ul {
    padding-left: 18px;
    display: grid;
    gap: 10px;
  }

  .pick-card li {
    font-size: 0.92rem;
    color: var(--ink-soft);
  }

  .pick-card-pro {
    border-color: var(--signal);
    position: relative;
  }

  .pick-flag {
    position: absolute;
    top: -11px;
    left: 24px;
    background: var(--signal);
    color: #fff;
    font-family: var(--font-mono);
    font-size: 0.66rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    padding: 3px 10px;
  }

  .faq-list {
    margin-top: clamp(28px, 4vw, 44px);
    max-width: 820px;
  }

  .faq-item {
    border-bottom: 1px solid var(--hairline);
  }

  .faq-item summary {
    cursor: pointer;
    font-weight: 600;
    padding: 18px 0;
    list-style-position: outside;
  }

  .faq-item p {
    padding-bottom: 20px;
    max-width: 64ch;
    color: var(--ink-soft);
  }

  .post-related-wrap {
    margin-top: clamp(40px, 5vw, 72px);
  }

  .related {
    display: flex;
    align-items: center;
    gap: 24px;
    flex-wrap: wrap;
    padding: 20px 24px;
    border: 1px solid var(--hairline);
    background: var(--paper-deep);
  }

  .related-label {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--muted);
  }

  .related a {
    font-weight: 600;
  }

  .post-cta-wrap {
    margin-top: clamp(24px, 3vw, 40px);
    padding-bottom: clamp(64px, 8vw, 112px);
  }

  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  @media (max-width: 800px) {
    .pick-grid {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 640px) {
    .post-hero {
      padding-top: clamp(48px, 12vw, 72px);
    }

    .post-hero h1 {
      font-size: var(--step-3);
    }

    .verdict {
      padding: 22px 20px;
    }

    .post-section .section-head h2 {
      font-size: var(--step-3);
    }
  }
</style>
