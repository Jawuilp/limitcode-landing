---
import Layout from "../layouts/Layout.astro";
import Nav from "../components/Nav.astro";
import Footer from "../components/Footer.astro";

const apiProviders = [
  { name: "OpenAI", detail: "Direct API key" },
  { name: "Anthropic", detail: "Direct API key" },
  { name: "Google Gemini", detail: "Google AI API key" },
  { name: "OpenRouter", detail: "Models enabled for your account" },
  { name: "DeepSeek", detail: "Direct OpenAI-compatible API" },
  { name: "Mistral AI", detail: "Direct OpenAI-compatible API" },
  { name: "Other compatible APIs", detail: "Groq, xAI, Together, and custom gateways" },
];

const accountProviders = [
  {
    name: "GitHub Copilot",
    status: "Account",
    detail: "Sign in with GitHub. Availability and model access depend on an eligible Copilot account or subscription.",
  },
  {
    name: "OpenAI Codex OAuth",
    status: "Account",
    detail: "Uses an OpenAI browser login and a local callback. Account eligibility, quotas, and endpoint behavior are controlled by OpenAI and may change.",
  },
  {
    name: "Google Antigravity OAuth **",
    status: "Experimental · elevated risk",
    detail: "Uses Google OAuth and Antigravity/Code Assist service behavior to access models available to the signed-in account.",
  },
];

const cliProviders = [
  { name: "Claude Code CLI", detail: "Uses an existing local `claude login` session." },
  { name: "Codex CLI", detail: "Uses an existing local `codex login` session." },
];

const localProviders = [
  { name: "Ollama", detail: "Default local OpenAI-compatible endpoint" },
  { name: "LM Studio", detail: "Local server and models managed by LM Studio" },
  { name: "LiteLLM", detail: "Local or remote provider gateway" },
  { name: "Custom endpoint", detail: "User-supplied OpenAI-compatible base URL" },
];
---

<Layout title="Providers — Limitcode Pro" description="API, OAuth, CLI, and local model connection methods available in Limitcode Pro." canonicalPath="/providers/">
  <Nav />
  <main>
    <section class="provider-hero">
      <div class="container">
        <span class="eyebrow reveal"><span class="dot"></span>Connection guide</span>
        <h1 class="reveal d1">Bring the model access you already use.</h1>
        <p class="lead reveal d2">Limitcode supports direct APIs, account sign-in, existing CLI sessions, and local OpenAI-compatible runtimes. Each route has different billing, privacy, and account-risk boundaries.</p>

        <div class="connection-map reveal d3" aria-label="Provider connection methods">
          <span><b>API key</b>Direct provider billing</span>
          <span><b>OAuth</b>Account eligibility applies</span>
          <span><b>CLI</b>Reuse a local login</span>
          <span><b>Local</b>Your endpoint, your runtime</span>
        </div>
      </div>
    </section>

    <section class="provider-section container">
      <div class="section-head">
        <span class="section-num">01 — Direct APIs</span>
        <h2>Use a provider-issued key.</h2>
        <p>Requests go from the plugin to the provider or gateway you select. Usage, rates, limits, and model availability remain with that service.</p>
      </div>

      <div class="catalog-grid">
        {apiProviders.map((provider) => (
          <article class="catalog-card">
            <span class="method">API KEY</span>
            <h3>{provider.name}</h3>
            <p>{provider.detail}</p>
          </article>
        ))}
      </div>
    </section>

    <section class="provider-section container account-section">
      <div class="section-head">
        <span class="section-num">02 — Account &amp; OAuth</span>
        <h2>Sign in when a provider supports account access.</h2>
        <p>These integrations depend on provider-controlled accounts and service behavior. Availability, quotas, and compatibility can change independently of Limitcode.</p>
      </div>

      <div class="account-list">
        {accountProviders.map((provider) => (
          <article class="account-card">
            <div>
              <span class="method">{provider.status}</span>
              <h3>{provider.name}</h3>
            </div>
            <p>{provider.detail}</p>
          </article>
        ))}
      </div>

      <div class="risk-stack">
        <aside class="risk-note antigravity-note">
          <strong>** Antigravity OAuth carries elevated account risk.</strong>
          <p>This is an unofficial, experimental integration that relies on Google OAuth and Antigravity/Code Assist service behavior. Google may change access, restrict usage, or suspend an account. Prefer a secondary Google account and proceed entirely at your own risk. Jawuil and Limitcode are not responsible for account restrictions, lost access, data loss, or service changes caused by Google.</p>
        </aside>
      </div>
    </section>

    <section class="provider-section container">
      <div class="split-sections">
        <div>
          <div class="section-head compact-head">
            <span class="section-num">03 — CLI sessions</span>
            <h2>Reuse an official local CLI login.</h2>
            <p>CLI bridges require the provider's command-line tool to be installed and authenticated before Limitcode starts the task.</p>
          </div>
          <div class="mini-list">
            {cliProviders.map((provider) => (
              <article>
                <h3>{provider.name}</h3>
                <p>{provider.detail}</p>
              </article>
            ))}
          </div>
          <p class="boundary-note">CLI-backed providers may run their own internal agent loop and tools, outside some Limitcode permission controls.</p>
        </div>

        <div>
          <div class="section-head compact-head">
            <span class="section-num">04 — Local &amp; custom</span>
            <h2>Point at your own runtime.</h2>
            <p>Local inference can remain on your machine when the endpoint and model are local. Tool calling depends on the endpoint and model implementation.</p>
          </div>
          <div class="mini-list">
            {localProviders.map((provider) => (
              <article>
                <h3>{provider.name}</h3>
                <p>{provider.detail}</p>
              </article>
            ))}
          </div>
        </div>
      </div>
    </section>

    <section class="provider-boundary">
      <div class="container boundary-grid">
        <div>
          <span class="eyebrow">Before connecting</span>
          <h2>Know where the request goes.</h2>
        </div>
        <div>
          <p>Prompts and any file context or tool results included in a request are sent to the selected provider or endpoint. Credentials are stored in Sublime Text settings, not an operating-system keychain. Review the provider's terms before connecting a work or primary personal account.</p>
          <a class="btn btn-primary" href="/#pricing">Return to Limitcode Pro <span class="arrow">→</span></a>
        </div>
      </div>
    </section>
  </main>
  <Footer />
</Layout>

<style>
  .provider-hero {
    padding-top: clamp(64px, 8vw, 112px);
    padding-bottom: clamp(72px, 9vw, 120px);
  }

  .provider-hero h1 {
    max-width: 13ch;
    margin: 18px 0 22px;
  }

  .provider-hero .lead {
    max-width: 52ch;
  }

  .connection-map {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    margin-top: clamp(48px, 6vw, 76px);
    border-top: 1px solid var(--hairline);
    border-bottom: 1px solid var(--hairline);
  }

  .connection-map span {
    display: flex;
    flex-direction: column;
    gap: 8px;
    min-height: 118px;
    padding: 24px;
    font-family: var(--font-mono);
    font-size: 0.76rem;
    color: var(--muted);
    border-right: 1px solid var(--hairline);
  }

  .connection-map span:last-child {
    border-right: 0;
  }

  .connection-map b {
    color: var(--ink);
    font-family: var(--font-display);
    font-size: 1.05rem;
  }

  .catalog-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    border-top: 1px solid var(--hairline);
    border-left: 1px solid var(--hairline);
  }

  .catalog-card {
    min-height: 190px;
    padding: 26px;
    border-right: 1px solid var(--hairline);
    border-bottom: 1px solid var(--hairline);
  }

  .method {
    display: inline-block;
    margin-bottom: 28px;
    font-family: var(--font-mono);
    font-size: 0.66rem;
    letter-spacing: 0.13em;
    text-transform: uppercase;
    color: var(--signal);
  }

  .catalog-card h3,
  .account-card h3,
  .mini-list h3 {
    margin-bottom: 10px;
  }

  .account-section {
    background: linear-gradient(135deg, rgba(232, 97, 50, 0.035), transparent 55%);
  }

  .account-list {
    border-top: 1px solid var(--hairline);
  }

  .account-card {
    display: grid;
    grid-template-columns: minmax(220px, 0.8fr) 1.4fr;
    gap: 40px;
    padding: 32px 0;
    border-bottom: 1px solid var(--hairline);
  }

  .account-card .method {
    margin-bottom: 12px;
  }

  .risk-stack {
    display: grid;
    grid-template-columns: 1fr;
    gap: 18px;
    margin-top: 44px;
  }

  .risk-note {
    padding: 24px;
    border: 1px solid var(--hairline);
    background: var(--paper-deep);
  }

  .risk-note strong {
    display: block;
    margin-bottom: 8px;
    color: var(--ink);
  }

  .antigravity-note {
    border-color: rgba(232, 97, 50, 0.42);
    border-left: 4px solid var(--signal);
    background: rgba(232, 97, 50, 0.07);
  }

  .split-sections {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: clamp(56px, 8vw, 110px);
  }

  .compact-head {
    margin-bottom: 36px;
  }

  .compact-head h2 {
    font-size: var(--step-3);
  }

  .mini-list {
    border-top: 1px solid var(--hairline);
  }

  .mini-list article {
    padding: 24px 0;
    border-bottom: 1px solid var(--hairline);
  }

  .boundary-note {
    margin-top: 22px;
    padding: 16px 18px;
    font-size: 0.86rem;
    background: var(--paper-deep);
    border-left: 3px solid var(--signal);
  }

  .provider-boundary {
    background: var(--ink);
    color: var(--paper);
  }

  .boundary-grid {
    display: grid;
    grid-template-columns: 0.8fr 1.2fr;
    gap: clamp(40px, 7vw, 100px);
  }

  .provider-boundary h2,
  .provider-boundary p {
    color: var(--paper);
  }

  .provider-boundary h2 {
    margin-top: 12px;
  }

  .provider-boundary .btn {
    margin-top: 30px;
  }

  @media (max-width: 800px) {
    .connection-map,
    .catalog-grid,
    .risk-stack,
    .split-sections,
    .boundary-grid {
      grid-template-columns: 1fr;
    }

    .connection-map span {
      min-height: auto;
      border-right: 0;
      border-bottom: 1px solid var(--hairline);
    }

    .connection-map span:last-child {
      border-bottom: 0;
    }

    .account-card {
      grid-template-columns: 1fr;
      gap: 14px;
    }
  }
</style>
