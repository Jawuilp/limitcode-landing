---
import Layout from "../layouts/Layout.astro";
import Nav from "../components/Nav.astro";
import Hero from "../components/Hero.astro";
import ProofStrip from "../components/ProofStrip.astro";
import WhyLimitcode from "../components/WhyLimitcode.astro";
import Lightweight from "../components/Lightweight.astro";
import Capabilities from "../components/Capabilities.astro";
import AgentWorkflow from "../components/AgentWorkflow.astro";
import Providers from "../components/Providers.astro";
import Installation from "../components/Installation.astro";
import Pricing from "../components/Pricing.astro";
import FAQ from "../components/FAQ.astro";
import Footer from "../components/Footer.astro";
---

<Layout>
  <!-- SoftwareApplication schema: lets AI engines and search engines treat
       Limitcode as a structured software product -->
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "SoftwareApplication",
    "name": "Limitcode Pro",
    "applicationCategory": "DeveloperApplication",
    "operatingSystem": "Windows, macOS",
    "applicationSubCategory": "Coding agent for Sublime Text",
    "description": "A lightweight coding-agent workflow inside Sublime Text: stay in your editor while Limitcode inspects project files, applies approved edits, runs approved commands, and uses skills, MCP servers, and web search under configurable permissions.",
    "url": "https://limitcode.jawuil.dev/",
    "offers": { "@type": "Offer", "price": "0", "priceCurrency": "USD" },
    "publisher": { "@id": "https://limitcode.jawuil.dev/#organization" },
    "featureList": "Side-by-side streaming chat, file inspection and edits, approved command execution, web search, skills, MCP servers, subagents, account sign-in for GitHub Copilot, OpenAI Codex, and Google Antigravity, local models via Ollama and LM Studio"
  })} />
  <Nav />
  <main>
    <Hero />
    <ProofStrip />
    <WhyLimitcode />
    <Lightweight />
    <Capabilities />
    <AgentWorkflow />
    <Providers />
    <Installation />
    <Pricing />
    <FAQ />
  </main>
  <Footer />
</Layout>
