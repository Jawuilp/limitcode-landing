---
import '../styles/global.css';

export interface Props {
  title?: string;
  description?: string;
  image?: string;
  imageAlt?: string;
  canonicalPath?: string;
}

const {
  title = 'Limitcode Pro: The Lightweight AI Coding Agent for Sublime Text',
  description = 'A lightweight AI coding agent for Sublime Text. Stay in your editor: multiple providers, approved edits and commands, and an agentic workflow without a separate AI IDE.',
  image = '/og.png',
  imageAlt = 'Limitcode Pro coding agent running in a side-by-side Sublime Text workflow.',
  canonicalPath = '/',
} = Astro.props;

const site = 'https://limitcode.jawuil.dev';
const canonical = site + canonicalPath;
const ogImage = site + image;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="description" content={description} />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#F3EFE5" />
    <meta name="robots" content="index, follow, max-image-preview:large" />
    <meta name="application-name" content="Limitcode Pro" />
    <meta name="author" content="Jawuil Pineda" />
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <link rel="canonical" href={canonical} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />

    <!-- Open Graph -->
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:secure_url" content={ogImage} />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={imageAlt} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content="Limitcode Pro" />
    <meta property="og:locale" content="en_US" />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:site" content="@jawuil_p" />
    <meta name="twitter:creator" content="@jawuil_p" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:image:alt" content={imageAlt} />

    <!-- Organization + WebSite schema (sitewide) -->
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@graph": [
        {
          "@type": "Organization",
          "@id": site + "/#organization",
          "name": "Jawuil",
          "url": "https://jawuil.dev",
          "email": "hola@jawuil.dev",
          "brand": { "@type": "Brand", "name": "Limitcode" }
        },
        {
          "@type": "WebSite",
          "@id": site + "/#website",
          "url": site,
          "name": "Limitcode Pro",
          "description": "A lightweight coding-agent workflow for Sublime Text: inspect files, apply approved edits, and run approved commands from a side-by-side chat, without a separate AI IDE.",
          "publisher": { "@id": site + "/#organization" },
          "inLanguage": "en"
        }
      ]
    })} />
    <script defer src="https://u.jawuil.dev/script.js" data-website-id="2b40f4c4-8977-4faa-bc77-c39cc66a80bc"></script>
    <script is:inline type="text/javascript">
      (function(c,l,a,r,i,t,y){
        c[a]=c[a]||function(){(c[a].q=c[a].q||[]).push(arguments)};
        t=l.createElement(r);t.async=1;t.src="https://www.clarity.ms/tag/"+i;
        y=l.getElementsByTagName(r)[0];y.parentNode.insertBefore(t,y);
      })(window, document, "clarity", "script", "y3fvhsr853");
    </script>
    <title>{title}</title>
    <slot name="head-extra" />
  </head>
  <body>
    <slot />
  </body>
</html>
