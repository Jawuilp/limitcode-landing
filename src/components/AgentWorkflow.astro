---
import VideoCard from "./VideoCard.astro";

const steps = [
  {
    num: "01",
    label: "Ask",
    title: "Hand over the task in seconds.",
    body: "Open the chat (Ctrl+Alt+L) and describe what you need. Type @ to attach project files, press Ctrl+Alt+A to send your active selection, or paste a screenshot (Ctrl+V).",
    meta: "Ctrl+Alt+L · @file paths · Ctrl+Alt+A selection · Ctrl+V screenshots",
  },
  {
    num: "02",
    label: "Inspect",
    title: "Let it explore your real project.",
    body: "Limitcode searches and reads the relevant files in your workspace and automatically picks up your repository's AGENTS.md instructions so it follows your conventions.",
    meta: "codebase search · file reads · automatic AGENTS.md rules",
  },
  {
    num: "03",
    label: "Act",
    title: "Approve edits, diffs, and commands.",
    body: "When the agent is ready to edit files, apply patches, or run tests and builds, it asks for your approval first — once, or for the rest of your session.",
    meta: "targeted edits · native diffs · shell commands · approval prompts",
  },
  {
    num: "04",
    label: "Review",
    title: "Accept, reject, or undo in one shortcut.",
    body: "Review proposed diffs inside Sublime Text, watch live task checklists complete, and revert any agent change at any time with Ctrl+Alt+U.",
    meta: "native diff toolbar · LSP self-correction · Ctrl+Alt+U Undo",
  },
];
---

<section id="how-it-works" class="workflow">
  <div class="container">
    <div class="section-head">
      <span class="section-num reveal">06 - Workflow</span>
      <h2 class="reveal d1">How a task flows inside Sublime Text.</h2>
      <p class="reveal d2">No context-switching between windows. You stay in the driver's seat while Limitcode explores, proposes changes, runs tests, and reports back into the same panel.</p>
    </div>

    <div class="workflow-grid">
      <!-- Left: steps -->
      <ol class="steps" role="list">
        {steps.map((s, i) => (
          <li class={`step reveal d${i + 1}`}>
            <span class="num">{s.num} →</span>
            <div>
              <h3><code>{s.label}</code> {s.title}</h3>
              <p>{s.body}</p>
              <div class="meta">{s.meta}</div>
            </div>
          </li>
        ))}
      </ol>

      <!-- Right: real demo video -->
      <div class="reveal d2">
        <VideoCard
          src="/limit-app-creaction.mp4?v=3"
          poster="/limit-app-creaction-poster.jpg"
          duration="1:15"
          caption="Limitcode Pro creating a Pomodoro app from scratch — scaffold, edits, build, verify."
        />
      </div>
    </div>
  </div>
</section>

<style>
  .demo-video {
    width: 100%;
    display: block;
    border-radius: 10px;
    border: 1px solid var(--hairline);
    background: #0f1117;
    box-shadow: 0 12px 40px rgba(0, 0, 0, 0.18);
  }
</style>
