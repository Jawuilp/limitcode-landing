---
const items = [
  "One-time $29 · zero subscriptions",
  "Native Sublime chat & diff review",
  "Bring your own API, OAuth, CLI, or local model",
  "You approve every edit & shell command",
];
---

<section class="proof" aria-label="At a glance">
  <div class="container">
    <div class="proof-row">
      <div class="proof-label">At a glance →</div>
      <div class="proof-items">
        {items.map((it) => <span>{it}</span>)}
      </div>
    </div>
  </div>
</section>
