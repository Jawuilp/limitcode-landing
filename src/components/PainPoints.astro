---
const pains = [
  {
    num: "01",
    pain: "You love Sublime's instant speed — but every AI tool expects you to switch to Cursor or VS Code.",
    relief: "Keep your theme, keybindings, and zero-lag startup. Limitcode lives directly inside the Sublime Text window you already have open.",
  },
  {
    num: "02",
    pain: "Copy-pasting code back and forth into a browser or external window breaks your concentration.",
    relief: "Press Ctrl+Alt+A to send your active selection or file straight to the agent, or mention any project file with @.",
  },
  {
    num: "03",
    pain: "You hate background daemons and bloated processes quietly eating system resources all day.",
    relief: "Direct API providers connect straight from the plugin with no separate background daemon. Close the chat tab and Sublime is untouched.",
  },
  {
    num: "04",
    pain: "Testing Claude, GPT, Gemini, or local models forces you to juggle four different tools and harnesses.",
    relief: "Use one consistent Sublime workflow across 40+ providers, OAuth accounts, CLI logins, and local Ollama or LM Studio models.",
  },
  {
    num: "05",
    pain: "You don't want an autonomous agent modifying files or running shell commands behind your back.",
    relief: "Reads stay frictionless while file edits, native diffs, and shell commands ask for your approval first — with one-shortcut Undo (Ctrl+Alt+U) anytime.",
  },
];
---

<section id="pains" class="pains">
  <div class="container">
    <div class="section-head">
      <span class="section-num reveal">01 — Sound familiar?</span>
      <h2 class="reveal d1">You didn't leave Sublime. The AI tools left you behind.</h2>
      <p class="reveal d2">
        Modern coding agents assume you want to abandon your editor for a heavy IDE fork or live inside a terminal.
        You shouldn't have to give up the fastest editor on your machine just to get a capable AI agent.
      </p>
    </div>

    <ol class="pain-list" role="list">
      {pains.map((item, i) => (
        <li class={`pain-row reveal d${i + 1}`}>
          <span class="pain-num">{item.num}</span>
          <div class="pain-body">
            <p class="pain-problem">{item.pain}</p>
            <p class="pain-relief"><span class="arrow" aria-hidden="true">→</span> {item.relief}</p>
          </div>
        </li>
      ))}
    </ol>

    <div class="pains-cta reveal">
      <a class="btn btn-primary" href="#pricing">
        Keep Sublime. Add the agent — $29 <span class="arrow">→</span>
      </a>
      <a class="btn btn-quiet" href="/about">
        See who it is (and isn't) built for <span class="arrow">→</span>
      </a>
    </div>
  </div>
</section>

<style>
  .pains {
    padding-top: clamp(56px, 7vw, 96px);
    padding-bottom: clamp(56px, 7vw, 96px);
  }

  .pain-list {
    list-style: none;
    padding: 0;
    margin: 0;
    border-top: 1px solid var(--hairline);
  }

  .pain-row {
    display: grid;
    grid-template-columns: 64px 1fr;
    gap: clamp(16px, 3vw, 32px);
    padding: clamp(20px, 3vw, 28px) 0;
    border-bottom: 1px solid var(--hairline);
    align-items: start;
  }

  .pain-num {
    font-family: var(--font-prose);
    font-size: 0.78rem;
    letter-spacing: 0.14em;
    color: var(--signal);
    padding-top: 4px;
  }

  .pain-body {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .pain-problem {
    font-family: var(--font-display);
    font-size: var(--step-2);
    font-weight: 600;
    letter-spacing: -0.015em;
    line-height: 1.25;
    color: var(--ink);
    max-width: 36ch;
    margin: 0;
  }

  .pain-relief {
    font-size: var(--step-0);
    color: var(--ink-soft);
    max-width: 54ch;
    margin: 0;
    display: flex;
    gap: 10px;
    align-items: baseline;
  }

  .pain-relief .arrow {
    color: var(--sage);
    font-family: var(--font-mono);
    flex-shrink: 0;
  }

  .pains-cta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 18px;
    margin-top: clamp(32px, 4vw, 48px);
  }

  @media (max-width: 600px) {
    .pain-row {
      grid-template-columns: 40px 1fr;
    }
  }
</style>
