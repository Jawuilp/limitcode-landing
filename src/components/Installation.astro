---
const steps = [
  {
    ord: "Step 01 / 03",
    title: "Download your Sublime build",
    body: "After checkout on Gumroad, copy your license key and download the package matched to your Sublime Text 4 build.",
    code: "Download Limitcode.sublime-package",
  },
  {
    ord: "Step 02 / 03",
    title: "Drop into Installed Packages & activate",
    body: "Move the file into Sublime's Installed Packages folder, restart Sublime Text, and activate your license from the Command Palette.",
    code: "Ctrl+Shift+P → Limitcode Pro: Activate License",
  },
  {
    ord: "Step 03 / 03",
    title: "Connect a provider & press Ctrl+Alt+L",
    body: "Paste an API key, sign in with Copilot / Codex / Antigravity, reuse Claude Code CLI, or connect local Ollama. Open the chat and start shipping.",
    code: "Ctrl+Shift+P → Limitcode: Setup Provider API Key",
  },
];
---

<section id="install" class="container">
  <div class="section-head">
    <span class="section-num">08 - Installation</span>
    <h2>Up and running in under two minutes.</h2>
    <p>No external daemon to configure. Drop the package in, connect your preferred model, and open the side-by-side chat with <code class="mono">Ctrl+Alt+L</code>.</p>
  </div>

  <div class="install-steps">
    {steps.map((s) => (
      <article class="install">
        <span class="ord">{s.ord}</span>
        <h3>{s.title}</h3>
        <p>{s.body}</p>
        <div class="code"><span class="c">$</span> {s.code.replace(/^\$\s*/, "")}</div>
      </article>
    ))}
  </div>

  <div style="display: flex; flex-wrap: wrap; gap: 24px; align-items: center;">
    <a class="docs-link" href="/docs/">
      Read the complete User Guide &amp; Documentation →
    </a>
    <a class="docs-link" href="mailto:hola@jawuil.dev?subject=Limitcode%20Pro%20installation">
      Need installation help? Email Jawuil →
    </a>
  </div>
</section>
