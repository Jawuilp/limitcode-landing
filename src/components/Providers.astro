---
const providers = [
  { name: "OpenAI & Codex", sub: "API key, OAuth, or Codex CLI", mark: "01" },
  { name: "Anthropic & Claude", sub: "API key or Claude Code CLI", mark: "02" },
  { name: "Google Gemini", sub: "API key or Antigravity OAuth", mark: "03" },
  { name: "GitHub Copilot", sub: "eligible GitHub account (OAuth)", mark: "04" },
  { name: "OpenRouter", sub: "500+ models with one API key", mark: "05" },
  { name: "DeepSeek, Mistral & Groq", sub: "direct API keys", mark: "06" },
  { name: "Local (Ollama / LM Studio)", sub: "private local inference", mark: "07" },
];
---

<section id="providers" class="container">
  <div class="section-head">
    <span class="section-num">07 - Providers</span>
    <h2>Bring the AI models and accounts you already pay for.</h2>
    <p>Switch between 40+ providers mid-conversation with <code class="mono">Ctrl+Alt+M</code>. Use direct API keys, OAuth accounts, existing CLI logins, or local models — with zero markup from Limitcode.</p>
  </div>

  <div class="providers-grid">
    <div>
      <div class="provider-list">
        {providers.map((p) => (
          <div class="provider">
            <span class="mark">{p.mark}</span>
            <span class="name">{p.name}</span>
            <span class="sub">{p.sub}</span>
          </div>
        ))}
      </div>
    </div>
    <div>
      <h3 style="margin-bottom: 16px;">One interface. Every major model.</h3>
      <p>Your API keys, subscriptions, rate limits, and billing stay strictly between you and your chosen provider. Swap models or adjust reasoning effort (<code class="mono">Ctrl+Alt+R</code>) at any point in a session.</p>
      <p style="margin-top: 14px;">Prefer 100% local inference? Point Limitcode at Ollama, LM Studio, LiteLLM, or any custom OpenAI-compatible gateway.</p>

      <div class="note">
        <span class="kicker">Direct connection</span>
        Prompts and project context go straight to the provider or local endpoint you select. Credentials live locally in your Sublime Text settings.
      </div>

      <a class="docs-link" href="/providers">Compare all 40+ supported providers →</a>
    </div>
  </div>
</section>
