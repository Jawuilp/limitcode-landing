---
import VideoCard from "./VideoCard.astro";

const capabilities = [
  {
    index: "01 / PROJECT",
    title: "Go from question to tested code in one place.",
    body: "Ask Limitcode to explore your folders, search across files, apply targeted edits or patches, and run your build or test suite — all from the same side-by-side conversation.",
    meta: ["inspect files", "targeted edits", "native diffs", "builds & tests"],
  },
  {
    index: "02 / CONTROL",
    title: "Every edit and command waits for your green light.",
    body: "File reads and searches stay fast and automatic, while file writes, diffs, shell commands, web lookups, and MCP tools ask for your approval first. Protect sensitive paths like .env by default.",
    meta: ["ask before mutating", "file protection", "session rules", "stop anytime"],
  },
  {
    index: "03 / RECOVERY & MEMORY",
    title: "Keep long sessions alive — and undo any edit in one shortcut.",
    body: "Conversations are saved per project and automatically summarized when context gets long so you never hit a wall. Every file edit is backed up so Ctrl+Alt+U reverts it immediately.",
    meta: ["project sessions", "long-session memory", "instant undo / redo"],
  },
  {
    index: "04 / EXTEND",
    title: "Teach it your repo's conventions, Skills, and MCP tools.",
    body: "Drop an AGENTS.md file in your repo, load reusable Agent Skills, connect local or remote MCP servers, and delegate focused work to subagents without leaving Sublime.",
    meta: ["AGENTS.md rules", "Agent Skills", "MCP servers", "subagents"],
    video: "/limit-search-skilss.mp4?v=3",
  },
];
---

<section id="features" class="capabilities container">
  <div class="section-head">
    <span class="section-num reveal">04 — Capabilities</span>
    <h2 class="reveal d1">A real coding agent, <em class="not-wrapper">not a chat wrapper</em>.</h2>
    <p class="reveal d2">Everything you need to plan, edit, test, and review real multi-file changes inside Sublime Text — while staying in complete control of your codebase.</p>
  </div>

  <div class="capability-ledger">
    {capabilities.map((capability, index) => (
      <article class={`capability reveal d${index + 1}`}>
        <span class="capability-index">{capability.index}</span>
        <h3>{capability.title}</h3>
        <p>{capability.body}</p>
        {capability.video && (
          <VideoCard
            src={capability.video}
            poster="/limit-search-skilss-poster.jpg"
            duration="0:31"
            alt="Limitcode Pro searching the web and loading skills inside Sublime Text (video preview)"
          />
        )}
        <div class="capability-meta">
          {capability.meta.map((item) => <code>{item}</code>)}
        </div>
      </article>
    ))}
  </div>
</section>

<style>
  .capabilities .section-head h2 em.not-wrapper {
    color: var(--signal);
    font-style: normal;
  }

  .capability-ledger {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    border-top: 1px solid var(--hairline);
    border-bottom: 1px solid var(--hairline);
  }

  .capability {
    min-height: 300px;
    padding: clamp(28px, 4vw, 48px);
    display: flex;
    flex-direction: column;
    border-bottom: 1px solid var(--hairline);
  }

  .capability:nth-child(odd) {
    border-right: 1px solid var(--hairline);
  }

  .capability:nth-last-child(-n + 2) {
    border-bottom: 0;
  }

  .capability-index {
    font-family: var(--font-prose);
    color: var(--signal);
    font-size: 0.72rem;
    letter-spacing: 0.12em;
    margin-bottom: auto;
  }

  .capability h3 {
    max-width: 18ch;
    margin: 48px 0 14px;
  }

  .capability p {
    max-width: 48ch;
  }

  .capability-video {
    width: 100%;
    margin-top: 20px;
    border-radius: 6px;
    border: 1px solid var(--hairline);
    background: #0f1117;
  }

  .capability-meta {
    display: flex;
    flex-wrap: wrap;
    gap: 7px;
    margin-top: 24px;
  }

  .capability-meta code {
    font-family: var(--font-mono);
    font-size: 0.68rem;
    color: var(--ink-soft);
    background: var(--paper-deep);
    border: 1px solid var(--hairline-soft);
    padding: 4px 7px;
    border-radius: 3px;
  }

  @media (max-width: 700px) {
    .capability-ledger {
      grid-template-columns: 1fr;
    }

    .capability,
    .capability:nth-child(odd),
    .capability:nth-last-child(-n + 2) {
      min-height: 260px;
      border-right: 0;
      border-bottom: 1px solid var(--hairline);
    }

    .capability:last-child {
      border-bottom: 0;
    }
  }
</style>
