---
const points = [
  {
    num: "01",
    title: "Zero editor migration",
    body: "Limitcode installs as a standard Sublime Text package. Your color scheme, keymap, multi-cursor habits, and project workspaces stay exactly where they are.",
  },
  {
    num: "02",
    title: "No background daemon for direct APIs",
    body: "When you connect an API key, Limitcode talks directly to your provider from inside Sublime Text — no extra background service sitting in your activity monitor.",
  },
  {
    num: "03",
    title: "Disappears the second you close the tab",
    body: "Want pure, distraction-free coding? Close the Limitcode chat view and Sublime is 100% back to normal — no intrusive inline ghosts or background indexing.",
  },
  {
    num: "04",
    title: "Your keys and subscriptions, zero markup",
    body: "Connect OpenAI, Anthropic, Gemini, OpenRouter, Mistral, Copilot, Codex, Antigravity, or local Ollama / LM Studio models. You pay your provider directly with zero middleman fees.",
  },
];
---

<section id="lightweight" class="lightweight">
  <div class="container">
    <div class="section-head">
      <span class="section-num reveal">04 — Built to stay lightweight</span>
      <h2 class="reveal d1">Full agent power, <em>Sublime Text restraint</em>.</h2>
      <p class="reveal d2">
        You chose Sublime because it respects your machine and your attention. Limitcode follows the same rule: ready in a split view when you have a task, invisible when you don't.
      </p>
    </div>

    <div class="light-grid">
      {points.map((p, i) => (
        <article class={`light-card reveal d${i + 1}`}>
          <span class="light-num">{p.num}</span>
          <h3>{p.title}</h3>
          <p>{p.body}</p>
        </article>
      ))}
    </div>
  </div>
</section>

<style>
  .lightweight {
    padding-top: clamp(56px, 7vw, 96px);
    padding-bottom: clamp(56px, 7vw, 96px);
    border-top: 1px solid var(--hairline);
  }

  .lightweight .section-head h2 em {
    color: var(--signal);
    font-style: normal;
  }

  .light-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 18px;
    margin-top: clamp(36px, 5vw, 60px);
  }

  .light-card {
    padding: clamp(26px, 3.5vw, 40px);
    border: 1px solid var(--hairline);
    background: var(--paper-deep);
  }

  .light-num {
    font-family: var(--font-prose);
    font-size: 0.72rem;
    color: var(--signal);
    letter-spacing: 0.14em;
  }

  .light-card h3 {
    font-size: var(--step-1);
    max-width: 22ch;
    margin: 14px 0 10px;
  }

  .light-card p {
    font-size: 0.94rem;
    color: var(--ink-soft);
    max-width: 52ch;
  }

  @media (max-width: 800px) {
    .light-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
