---
const points = [
  {
    num: "01",
    title: "No separate AI IDE",
    body: "Limitcode is a package inside the Sublime Text you already use — your theme, keybindings, and projects stay exactly where they are. There is no new editor to move into and maintain.",
  },
  {
    num: "02",
    title: "No separate agent daemon for direct API providers",
    body: "Direct API providers connect straight from the plugin: bring your own key and Limitcode talks to the provider from inside Sublime Text. Account, CLI, and local integrations use their own optional setup.",
  },
  {
    num: "03",
    title: "Stays out of the way when not in use",
    body: "The agent lives in its own chat view. Close it and Sublime is exactly as it was — no separate Limitcode agent daemon runs for direct API providers, no filesystem roaming on its own, one task at a time, visible as it happens.",
  },
  {
    num: "04",
    title: "Your keys, your providers",
    body: "Bring your own API keys or accounts: OpenAI, Anthropic, Gemini, OpenRouter, Mistral AI, Copilot, Codex, Antigravity, or local endpoints like Ollama and LM Studio. Provider relationships and usage stay yours.",
  },
];
---

<section id="lightweight" class="lightweight">
  <div class="container">
    <div class="section-head">
      <span class="section-num reveal">03 — Built to stay lightweight</span>
      <h2 class="reveal d1">Agentic workflow, <em>without the heavy setup</em>.</h2>
      <p class="reveal d2">
        Limitcode is built to keep the Sublime workflow lightweight: the agent
        runs where your editor runs, with the boundaries you set, and gets out
        of the way when you don't need it.
      </p>
    </div>

    <div class="light-grid">
      {points.map((p, i) => (
        <article class={`light-card reveal d${i + 1}`}>
          <span class="light-num">{p.num}</span>
          <h3>{p.title}</h3>
          <p>{p.body}</p>
        </article>
      ))}
    </div>
  </div>
</section>

<style>
  .lightweight {
    padding-top: clamp(56px, 7vw, 96px);
    padding-bottom: clamp(56px, 7vw, 96px);
    border-top: 1px solid var(--hairline);
  }

  .lightweight .section-head h2 em {
    color: var(--signal);
    font-style: normal;
  }

  .light-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 18px;
    margin-top: clamp(36px, 5vw, 60px);
  }

  .light-card {
    padding: clamp(26px, 3.5vw, 40px);
    border: 1px solid var(--hairline);
    background: var(--paper-deep);
  }

  .light-num {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    color: var(--signal);
    letter-spacing: 0.14em;
  }

  .light-card h3 {
    font-size: var(--step-1);
    max-width: 22ch;
    margin: 14px 0 10px;
  }

  .light-card p {
    font-size: 0.94rem;
    color: var(--ink-soft);
    max-width: 52ch;
  }

  @media (max-width: 800px) {
    .light-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
